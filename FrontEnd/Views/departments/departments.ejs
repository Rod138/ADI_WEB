<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/main.css">
    <link rel="stylesheet" href="/FrontEnd/CSS/deps.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Departamentos</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <script src="/FrontEnd/JS/departments.js" defer></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        .role-badge #user-role {
            white-space: normal;
        }
    </style>
</head>
<body class="sidebar-expanded" data-min-role="1">
    <nav class="top-nav">
        <div class="nav-brand">
            <button type="button" class="nav-icon-btn sidebar-toggle" id="sidebar-toggle" aria-label="Alternar barra lateral" aria-expanded="false">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">DEPARTAMENTOS</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesión">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <aside class="adi-sidebar" id="adi-sidebar" aria-label="Barra lateral de navegación">
        <nav class="sidebar-nav" aria-label="Accesos rápidos">
            <a class="sidebar-link" href="/main" data-label="Menú principal">
                <span class="material-symbols-outlined">dashboard</span>
                <div class="sidebar-link-copy">
                    <strong>Menú principal</strong>
                </div>
            </a>
            <div class="sidebar-link has-submenu" id="accounting-menu" data-label="Finanzas">
                <span class="material-symbols-outlined">payments</span>
                <div class="sidebar-link-copy">
                    <strong>Finanzas</strong>
                </div>
                <span class="material-symbols-outlined toggle-arrow">expand_more</span>
            </div>
            <nav class="sidebar-submenu" id="accounting-submenu">
                <a class="sidebar-sublink" href="/accounting" data-label="Tablero">
                    <span class="material-symbols-outlined">dashboard</span>
                    <div class="sidebar-link-copy">
                        <strong>Finanzas</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/finance-config" data-label="Configuración">
                    <span class="material-symbols-outlined">settings</span>
                    <div class="sidebar-link-copy">
                        <strong>Configuración</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/expenses-board" data-label="Gastos">
                    <span class="material-symbols-outlined">receipt_long</span>
                    <div class="sidebar-link-copy">
                        <strong>Gastos del condominio</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/payment" data-label="Pagos">
                    <span class="material-symbols-outlined">payment</span>
                    <div class="sidebar-link-copy">
                        <strong>Mis cuotas</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/receipts-board" data-label="Recibos">
                    <span class="material-symbols-outlined">inventory_2</span>
                    <div class="sidebar-link-copy">
                        <strong>Cuotas de residentes</strong>
                    </div>
                </a>
            </nav>
            <a class="sidebar-link" href="/incident-board" data-label="Incidencias">
                <span class="material-symbols-outlined">warning</span>
                <div class="sidebar-link-copy">
                    <strong>Incidencias</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/reports" data-label="Reportes">
                <span class="material-symbols-outlined">bar_chart</span>
                <div class="sidebar-link-copy">
                    <strong>Reportes</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/departments" data-label="Departamentos">
                <span class="material-symbols-outlined">apartment</span>
                <div class="sidebar-link-copy">
                    <strong>Departamentos</strong>
                </div>
            </a>
        </nav>
    </aside>

    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <main class="main-container departments-page">
        <section class="deps-panel">
            <div class="search-bar">
                <div class="filter-group">
                    <label for="dep-select">Departamento</label>
                    <select id="dep-select">
                        <option value="">- Selecciona un departamento -</option>
                    </select>
                </div>
                <div class="filter-group" id="user-filter-group">
                    <label for="user-select">Usuario</label>
                    <select id="user-select" disabled>
                        <option value="">- Selecciona un usuario -</option>
                    </select>
                </div>
            </div>

            <div class="cards-row" id="cards-row" style="display:none">
                <div class="dep-card" id="dep-card">
                    <h3 class="card-title">Departamento</h3>
                    <div class="info-row">
                        <span class="info-label">Nombre</span>
                        <span class="info-value" id="dep-name">-</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Estado</span>
                        <span class="info-value" id="dep-status">-</span>
                    </div>

                    <div id="dep-edit-section" style="display:none">
                        <hr class="divider">
                        <h4 class="section-subtitle">Actualizar estado:</h4>
                        <label class="checkbox-label">
                            <input type="checkbox" id="dep-in-use-chk">
                            Departamento en uso
                        </label>
                        <label class="checkbox-label confirm-chk">
                            <input type="checkbox" id="dep-confirm-chk">
                            Confirmo los cambios
                        </label>
                        <p class="warning-text" id="dep-warning" style="display:none">
                            Aviso: Al deshabilitar el departamento, los datos del usuario asignado se resetearán.
                        </p>
                        <button class="save-btn" id="dep-save-btn">Guardar cambios</button>
                    </div>
                </div>

                <div class="user-card" id="user-card">
                    <div class="card-title-row">
                        <h3 class="card-title">Usuario</h3>
                        <button class="create-user-btn" id="create-user-btn" style="display:none">+ Crear residente</button>
                    </div>
                    <div id="user-view">
                        <!-- populated by JS -->
                    </div>

                    <div id="user-edit-section" style="display:none">
                        <hr class="divider">
                        <h4 class="section-subtitle">Editar usuario</h4>
                        <div class="edit-grid">
                            <div class="edit-field">
                                <label for="edit-name">Nombre</label>
                                <input type="text" id="edit-name">
                            </div>
                            <div class="edit-field">
                                <label for="edit-ap">Apellido paterno</label>
                                <input type="text" id="edit-ap" placeholder="(opcional)">
                            </div>
                            <div class="edit-field">
                                <label for="edit-am">Apellido materno</label>
                                <input type="text" id="edit-am" placeholder="(opcional)">
                            </div>
                            <div class="edit-field">
                                <label for="edit-email">Email</label>
                                <input type="email" id="edit-email">
                            </div>
                            <div class="edit-field">
                                <label for="edit-phone">Teléfono</label>
                                <input type="text" id="edit-phone">
                            </div>
                            <div class="edit-field" id="edit-rol-field">
                                <label for="edit-rol">Rol</label>
                                <select id="edit-rol"></select>
                            </div>
                        </div>
                        <label class="checkbox-label confirm-chk">
                            <input type="checkbox" id="user-confirm-chk">
                            Confirmo los cambios
                        </label>
                        <div class="user-actions-row">
                            <button class="save-btn" id="user-save-btn">Guardar cambios</button>
                            <button class="save-btn delete-user-btn" id="user-delete-btn" style="display:none">Eliminar usuario</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="bottom-actions">
            <a href="/main" class="btn-back">REGRESAR</a>
        </div>
    </main>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const user = window.ADIAuth?.getCurrentUser?.();
            if (user) {
                const roleSpan = document.getElementById('user-role');
                if (roleSpan) roleSpan.textContent = window.ADIAuth.getRoleLabel(user.rol_id);
            }

            // Sidebar toggle functionality
            const sidebar = document.getElementById('adi-sidebar');
            const backdrop = document.getElementById('sidebar-backdrop');
            const toggle = document.getElementById('sidebar-toggle');

            const setSidebarOpen = (open) => {
                document.body.classList.toggle('sidebar-open', open);
                toggle?.setAttribute('aria-expanded', String(open));
            };

            toggle?.addEventListener('click', () => {
                setSidebarOpen(!document.body.classList.contains('sidebar-open'));
            });

            backdrop?.addEventListener('click', () => setSidebarOpen(false));

            sidebar?.addEventListener('click', (e) => {
                if (window.innerWidth <= 768 && e.target.closest('a')) {
                    setSidebarOpen(false);
                }
            });

            if (window.innerWidth <= 768) {
                setSidebarOpen(false);
            }

            // Highlight active sidebar link
            const currentPath = window.location.pathname;
            document.querySelectorAll('.sidebar-link').forEach(link => {
                const href = link.getAttribute('href');
                if (href === '/departments' && currentPath === '/departments') {
                    link.classList.add('active');
                }
            });
            const headerLink = document.querySelector('.sidebar-header-link');
            if (headerLink && currentPath === '/main') headerLink.classList.add('active');
        });
    </script>
    <footer>
        <p>X-CORP</p>
    </footer>
</body>
</html>









