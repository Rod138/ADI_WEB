<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/main.css">
    <link rel="stylesheet" href="/FrontEnd/CSS/deps.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Departamentos</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <script src="/FrontEnd/JS/departments.js" defer></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        @media (max-width: 60rem) {
            .role-badge {
                display: none;
            }
        }
        .role-badge #user-role {
            white-space: normal;
        }
        /* Notificaciones: dropdown compacto usado en el menú principal */
        .notifications-wrapper {
            position: relative;
            display: inline-block;
        }
        .notifications-badge {
            position: absolute;
            top: -6px;
            right: -6px;
            min-width: 18px;
            height: 18px;
            background: #d33;
            color: white;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            padding: 0 4px;
        }
        .notifications-dropdown {
            position: absolute;
            right: 0;
            top: 2.5rem;
            width: 320px;
            max-height: 420px;
            background: white;
            border: 1px solid rgba(0,0,0,0.08);
            box-shadow: 0 6px 18px rgba(0,0,0,0.12);
            border-radius: 8px;
            overflow: hidden;
            z-index: 1200;
            display: flex;
            flex-direction: column;
        }
        .notifications-dropdown.hidden {
            display: none !important;
        }
        .notifications-dropdown .nd-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            border-bottom: 1px solid #e8e8e8;
            font-weight: 700;
            font-size: 0.95rem;
            color: #333;
        }
        .notifications-dropdown .nd-list {
            overflow-y: auto;
            padding: 8px;
            max-height: 350px;
        }
        .nd-item {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 12px;
            margin-bottom: 6px;
            border-radius: 6px;
            align-items: flex-start;
            cursor: pointer;
            transition: background 0.15s;
        }
        .nd-item:hover {
            background: rgba(0, 0, 0, 0.03);
        }
        .nd-item.unread {
            background: rgba(106, 128, 66, 0.08);
        }
        .nd-item.unread:hover {
            background: rgba(106, 128, 66, 0.12);
        }
        .nd-item .nd-left {
            display: flex;
            gap: 0;
            align-items: flex-start;
            flex: 1;
            min-width: 0;
        }
        .nd-item .nd-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #222;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            line-clamp: 1;
            -webkit-box-orient: vertical;
            word-break: break-word;
        }
        .nd-item .nd-desc {
            font-size: 0.8rem;
            color: #555;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            line-clamp: 2;
            -webkit-box-orient: vertical;
            margin-top: 4px;
            line-height: 1.3;
            word-break: break-word;
        }
        .nd-item .nd-time {
            font-size: 0.75rem;
            color: #888;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .nd-item .nd-delete {
            font-size: 1.5rem;
            padding: 0;
            line-height: 1;
            opacity: 0.6;
            transition: opacity 0.15s;
            flex-shrink: 0;
        }
        .nd-item .nd-delete:hover {
            opacity: 1;
        }
        .nd-empty {
            padding: 24px 16px;
            text-align: center;
            color: #888;
            font-size: 0.9rem;
        }
    </style>
</head>
<body class="sidebar-expanded" data-min-role="1">
    <nav class="top-nav">
        <div class="nav-brand">
            <button type="button" class="nav-icon-btn sidebar-toggle" id="sidebar-toggle" aria-label="Alternar barra lateral" aria-expanded="true">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">DEPARTAMENTOS</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <div class="notifications-wrapper">
                <button id="nav-notifications-btn" class="nav-icon-btn" aria-label="Notificaciones" aria-haspopup="true" aria-expanded="false">
                    <span class="material-symbols-outlined">notifications</span>
                </button>
                <div id="notifications-dropdown" class="notifications-dropdown hidden">
                    <div class="nd-header">
                        <span>Notificaciones</span>
                        <div>
                            <button id="delete-all-btn-mini" class="nav-icon-btn" title="Borrar todas">Borrar</button>
                        </div>
                    </div>
                    <div id="nav-noti-list" class="nd-list"></div>
                    <a href="/notifications" style="padding:8px 12px; border-top:1px solid #f7f7f7; text-align:center; font-weight:600; text-decoration:none; color:inherit">Ver todas</a>
                </div>
            </div>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn logout-link" href="/" aria-label="Cerrar sesión">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <%- include('../partials/sidebar') %>

    <main class="main-container departments-page">
        <section class="deps-panel">
            <div class="search-bar">
                <div class="filter-group">
                    <label for="dep-select">Departamento</label>
                    <select id="dep-select">
                        <option value="">- Selecciona un departamento -</option>
                    </select>
                </div>
                <div class="filter-group" id="user-filter-group">
                    <label for="user-select">Usuario</label>
                    <select id="user-select" disabled>
                        <option value="">- Selecciona un usuario -</option>
                    </select>
                </div>
            </div>

            <div class="cards-row" id="cards-row" style="display:none">
                <div class="dep-card" id="dep-card">
                    <h3 class="card-title">Departamento</h3>
                    <div class="info-row">
                        <span class="info-label">Nombre</span>
                        <span class="info-value" id="dep-name">-</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Estado</span>
                        <span class="info-value" id="dep-status">-</span>
                    </div>

                    <div id="dep-edit-section" style="display:none">
                        <hr class="divider">
                        <h4 class="section-subtitle">Actualizar estado:</h4>
                        <label class="checkbox-label">
                            <input type="checkbox" id="dep-in-use-chk">
                            Departamento en uso
                        </label>
                        <label class="checkbox-label confirm-chk">
                            <input type="checkbox" id="dep-confirm-chk">
                            Confirmo los cambios
                        </label>
                        <p class="warning-text" id="dep-warning" style="display:none">
                            Aviso: Al deshabilitar el departamento, los datos del usuario asignado se resetearán.
                        </p>
                        <button class="save-btn" id="dep-save-btn">Guardar cambios</button>
                    </div>
                </div>

                <div class="user-card" id="user-card">
                    <div class="card-title-row">
                        <h3 class="card-title">Usuario</h3>
                        <button class="create-user-btn" id="create-user-btn" style="display:none">+ Crear residente</button>
                    </div>
                    <div id="user-view">
                        <!-- populated by JS -->
                    </div>

                    <div id="user-edit-section" style="display:none">
                        <hr class="divider">
                        <h4 class="section-subtitle">Editar usuario</h4>
                        <div class="edit-grid">
                            <div class="edit-field">
                                <label for="edit-name">Nombre</label>
                                <input type="text" id="edit-name">
                            </div>
                            <div class="edit-field">
                                <label for="edit-ap">Apellido paterno</label>
                                <input type="text" id="edit-ap" placeholder="(opcional)">
                            </div>
                            <div class="edit-field">
                                <label for="edit-am">Apellido materno</label>
                                <input type="text" id="edit-am" placeholder="(opcional)">
                            </div>
                            <div class="edit-field">
                                <label for="edit-email">Email</label>
                                <input type="email" id="edit-email">
                            </div>
                            <div class="edit-field">
                                <label for="edit-phone">Teléfono</label>
                                <input type="text" id="edit-phone">
                            </div>
                            <div class="edit-field" id="edit-rol-field">
                                <label for="edit-rol">Rol</label>
                                <select id="edit-rol"></select>
                            </div>
                        </div>
                        <label class="checkbox-label confirm-chk">
                            <input type="checkbox" id="user-confirm-chk">
                            Confirmo los cambios
                        </label>
                        <div class="user-actions-row">
                            <button class="save-btn" id="user-save-btn">Guardar cambios</button>
                            <button class="save-btn delete-user-btn" id="user-delete-btn" style="display:none">Eliminar usuario</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="bottom-actions">
            <a href="/main" class="btn-back">REGRESAR</a>
        </div>
    </main>
    <script>
        document.querySelectorAll('.soon').forEach(function (card) {
            card.addEventListener('click', function (e) {
                e.preventDefault();
                Swal.fire({
                    title: this.dataset.feature + ' próximamente',
                    text: 'Esta sección aún no está disponible.',
                    icon: 'info',
                    confirmButtonText: 'Aceptar',
                    confirmButtonColor: '#6A8042'
                });
            });
        });
    </script>
    <script src="/FrontEnd/JS/notifications_menu.js"></script>
</body>
</html>









