<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/main.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Menú Principal</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
    </style>
</head>

<body data-min-role="1">
    <nav class="top-nav">
        <div class="nav-brand">
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">MENÚ PRINCIPAL</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <%= user.roleLabel %>
            </div>
            <a href="/notifications" class="nav-icon-btn" aria-label="Notificaciones">
                <span class="material-symbols-outlined">notifications</span>
            </a>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn logout-link" href="/" aria-label="Cerrar sesión">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>
    <div class="main-container">
        <div class="welcome">
            <h1>BIENVENIDO <span id="user-name"><%= user.name %></span></h1>
        </div>
        <section class="cards-grid cards-count-<%= menuItems.length %>" aria-label="Accesos del sistema">
            <% menuItems.forEach(item => { %>
                <a class="menu-card <%= item.button_class %>" href="<%= item.href %>">
                    <div class="card-content">
                        <h3 class="card-title"><%= item.title %></h3>
                        <% if (item.subtitle) { %>
                            <p class="card-subtitle"><%= item.subtitle %></p>
                        <% } %>
                    </div>
                </a>
            <% }); %>
        </section>
    </div>
    <footer>
        <p>X-CORP</p>
    </footer>
    <script>
        document.querySelectorAll('.soon').forEach(function (card) {
            card.addEventListener('click', function (e) {
                e.preventDefault();
                Swal.fire({
                    title: this.dataset.feature + ' próximamente',
                    text: 'Esta sección aún no está disponible.',
                    icon: 'info',
                    confirmButtonText: 'Aceptar',
                    confirmButtonColor: '#6A8042'
                });
            });
        });
    </script>
</body>

</html>




