<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/main.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Menú Principal</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        @media (max-width: 60rem) {
            .role-badge {
                display: none;
            }
        }
        .sidebar-toggle {
            border: none;
            background: transparent;
            padding: 0;
            margin-right: 0.25rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .sidebar-toggle .material-symbols-outlined {
            font-size: 1.9rem;
        }
        /* Notificaciones: dropdown compacto usado en el menú principal */
        .notifications-wrapper {
            position: relative;
            display: inline-block;
        }
        .notifications-badge {
            position: absolute;
            top: -6px;
            right: -6px;
            min-width: 18px;
            height: 18px;
            background: #d33;
            color: white;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            padding: 0 4px;
        }
        .notifications-dropdown {
            position: absolute;
            right: 0;
            top: 2.5rem;
            width: 320px;
            max-height: 420px;
            background: white;
            border: 1px solid rgba(0,0,0,0.08);
            box-shadow: 0 6px 18px rgba(0,0,0,0.12);
            border-radius: 8px;
            overflow: hidden;
            z-index: 1200;
            display: flex;
            flex-direction: column;
        }
        .notifications-dropdown.hidden {
            display: none !important;
        }
        .notifications-dropdown .nd-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            border-bottom: 1px solid #e8e8e8;
            font-weight: 700;
            font-size: 0.95rem;
            color: #333;
        }
        .notifications-dropdown .nd-list {
            overflow-y: auto;
            padding: 8px;
            max-height: 350px;
        }
        .nd-item {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 12px;
            margin-bottom: 6px;
            border-radius: 6px;
            align-items: flex-start;
            cursor: pointer;
            transition: background 0.15s;
        }
        .nd-item:hover {
            background: rgba(0, 0, 0, 0.03);
        }
        .nd-item.unread {
            background: rgba(106, 128, 66, 0.08);
        }
        .nd-item.unread:hover {
            background: rgba(106, 128, 66, 0.12);
        }
        .nd-item .nd-left {
            display: flex;
            gap: 0;
            align-items: flex-start;
            flex: 1;
            min-width: 0;
        }
        .nd-item .nd-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #222;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            word-break: break-word;
        }
        .nd-item .nd-desc {
            font-size: 0.8rem;
            color: #555;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            margin-top: 4px;
            line-height: 1.3;
            word-break: break-word;
        }
        .nd-item .nd-time {
            font-size: 0.75rem;
            color: #888;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .nd-item .nd-delete {
            font-size: 1.5rem;
            padding: 0;
            line-height: 1;
            opacity: 0.6;
            transition: opacity 0.15s;
            flex-shrink: 0;
        }
        .nd-item .nd-delete:hover {
            opacity: 1;
        }
        .nd-empty {
            padding: 24px 16px;
            text-align: center;
            color: #888;
            font-size: 0.9rem;
        }
    </style>
</head>

<body class="sidebar-expanded main-page" data-min-role="1">
    <nav class="top-nav">
        <div class="nav-brand">
            <button type="button" class="nav-icon-btn sidebar-toggle" id="sidebar-toggle" aria-label="Alternar barra lateral" aria-expanded="true">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">MENÚ PRINCIPAL</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <%= user.roleLabel %>
            </div>
            <div class="notifications-wrapper">
                <button id="nav-notifications-btn" class="nav-icon-btn" aria-label="Notificaciones" aria-haspopup="true" aria-expanded="false">
                    <span class="material-symbols-outlined">notifications</span>
                </button>
                <div id="notifications-dropdown" class="notifications-dropdown hidden">
                    <div class="nd-header">
                        <span>Notificaciones</span>
                        <div>
                            <button id="delete-all-btn-mini" class="nav-icon-btn" title="Borrar todas">Borrar</button>
                        </div>
                    </div>
                    <div id="nav-noti-list" class="nd-list"></div>
                    <a href="/notifications" style="padding:8px 12px; border-top:1px solid #f7f7f7; text-align:center; font-weight:600; text-decoration:none; color:inherit">Ver todas</a>
                </div>
            </div>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn logout-link" href="/" aria-label="Cerrar sesión">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <aside class="adi-sidebar" id="adi-sidebar" aria-label="Barra lateral de navegación">
        <nav class="sidebar-nav" aria-label="Accesos rápidos">
            <a class="sidebar-link" href="/main" data-label="Menú principal">
                <span class="material-symbols-outlined">dashboard</span>
                <div class="sidebar-link-copy">
                    <strong>Menú principal</strong>
                </div>
            </a>
            <div class="sidebar-link has-submenu" id="accounting-menu" data-label="Finanzas">
                <span class="material-symbols-outlined">payments</span>
                <div class="sidebar-link-copy">
                    <strong>Finanzas</strong>
                </div>
                <span class="material-symbols-outlined toggle-arrow">expand_more</span>
            </div>
            <nav class="sidebar-submenu" id="accounting-submenu">
                <a class="sidebar-sublink" href="/accounting" data-label="Tablero">
                    <span class="material-symbols-outlined">dashboard</span>
                    <div class="sidebar-link-copy">
                        <strong>Finanzas</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/finance-config" data-label="Configuración">
                    <span class="material-symbols-outlined">settings</span>
                    <div class="sidebar-link-copy">
                        <strong>Configuración</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/expenses-board" data-label="Gastos">
                    <span class="material-symbols-outlined">receipt_long</span>
                    <div class="sidebar-link-copy">
                        <strong>Gastos del condominio</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/payment" data-label="Pagos">
                    <span class="material-symbols-outlined">payment</span>
                    <div class="sidebar-link-copy">
                        <strong>Mis cuotas</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/receipts-board" data-label="Recibos">
                    <span class="material-symbols-outlined">inventory_2</span>
                    <div class="sidebar-link-copy">
                        <strong>Cuotas de residentes</strong>
                    </div>
                </a>
            </nav>
            <a class="sidebar-link" href="/incident-board" data-label="Incidencias">
                <span class="material-symbols-outlined">warning</span>
                <div class="sidebar-link-copy">
                    <strong>Incidencias</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/reports" data-label="Reportes">
                <span class="material-symbols-outlined">bar_chart</span>
                <div class="sidebar-link-copy">
                    <strong>Reportes</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/departments" data-label="Departamentos">
                <span class="material-symbols-outlined">apartment</span>
                <div class="sidebar-link-copy">
                    <strong>Departamentos</strong>
                </div>
            </a>
            <div class="sidebar-link has-submenu" id="support-menu" data-label="Soporte">
                <span class="material-symbols-outlined">support_agent</span>
                <div class="sidebar-link-copy">
                    <strong>Soporte</strong>
                </div>
                <span class="material-symbols-outlined toggle-arrow">expand_more</span>
            </div>
            <nav class="sidebar-submenu" id="support-submenu">
                <a class="sidebar-sublink" href="/support" data-label="Centro de ayuda">
                    <span class="material-symbols-outlined">space_dashboard</span>
                    <div class="sidebar-link-copy">
                        <strong>Centro de ayuda</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/support/faqs" data-label="Preguntas frecuentes">
                    <span class="material-symbols-outlined">quiz</span>
                    <div class="sidebar-link-copy">
                        <strong>Preguntas frecuentes</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/support/tickets" data-label="Tickets propios">
                    <span class="material-symbols-outlined">confirmation_number</span>
                    <div class="sidebar-link-copy">
                        <strong>Tickets propios</strong>
                    </div>
                </a>
            </nav>
        </nav>
    </aside>

    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <div class="main-container">
        <div class="welcome">
            <h1>BIENVENIDO <span id="user-name"><%= user.name %></span></h1>
        </div>
        <section class="cards-grid cards-count-<%= menuItems.length %>" aria-label="Accesos del sistema">
            <% menuItems.forEach((item, index) => { %>
                <a class="menu-card <%= item.button_class %> <%= menuItems.length === 5 && index === menuItems.length - 1 ? 'center-last' : '' %>" href="<%= item.href %>">
                    <div class="card-content">
                        <h3 class="card-title"><%= item.title %></h3>
                        <% if (item.subtitle) { %>
                            <p class="card-subtitle"><%= item.subtitle %></p>
                        <% } %>
                    </div>
                </a>
            <% }); %>
        </section>
    </div>
    <footer>
        <p>X-CORP</p>
        <p class="site-legal">
            <a class="footer-link" href="/politicas">Políticas de Privacidad</a>
            &nbsp;|&nbsp;
            <a class="footer-link" href="/terminos">Términos y Condiciones</a>
        </p>
    </footer>
    <script>
        document.querySelectorAll('.soon').forEach(function (card) {
            card.addEventListener('click', function (e) {
                e.preventDefault();
                Swal.fire({
                    title: this.dataset.feature + ' próximamente',
                    text: 'Esta sección aún no está disponible.',
                    icon: 'info',
                    confirmButtonText: 'Aceptar',
                    confirmButtonColor: '#6A8042'
                });
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('adi-sidebar');
            const backdrop = document.getElementById('sidebar-backdrop');
            const toggle = document.getElementById('sidebar-toggle');
            const body = document.body;
            const isDesktop = window.innerWidth > 768;

            // Initialize sidebar state from localStorage
            const sidebarState = localStorage.getItem('sidebarExpanded');
            const isExpanded = sidebarState === null ? true : sidebarState === 'true';

            const setSidebarExpanded = (expanded) => {
                body.classList.toggle('sidebar-expanded', expanded);
                body.classList.toggle('sidebar-collapsed', !expanded);
                toggle?.setAttribute('aria-expanded', String(expanded));

                // Only save state on desktop
                if (isDesktop) {
                    localStorage.setItem('sidebarExpanded', String(expanded));
                }
            };

            // Set initial state
            if (isDesktop) {
                setSidebarExpanded(isExpanded);
            } else {
                body.classList.add('sidebar-expanded');
                body.classList.remove('sidebar-collapsed');
            }

            // Toggle button click
            toggle?.addEventListener('click', () => {
                if (isDesktop) {
                    // Desktop: toggle between expanded and collapsed
                    const currentExpanded = body.classList.contains('sidebar-expanded');
                    setSidebarExpanded(!currentExpanded);
                } else {
                    // Mobile: toggle sidebar visibility with backdrop
                    setSidebarOpen(!body.classList.contains('sidebar-open'));
                }
            });

            // Mobile-specific sidebar open/close
            const setSidebarOpen = (open) => {
                body.classList.toggle('sidebar-open', open);
                body.classList.toggle('sidebar-backdrop-active', open);
            };

            // Backdrop click closes sidebar on mobile
            backdrop?.addEventListener('click', () => {
                if (!isDesktop) {
                    setSidebarOpen(false);
                }
            });

            // Sidebar link click behavior
            sidebar?.addEventListener('click', (e) => {
                if (e.target.closest('a.sidebar-link')) {
                    // On mobile, close sidebar when clicking a link
                    if (!isDesktop) {
                        setSidebarOpen(false);
                    }
                }
            });

            // Handle submenu toggle
            const accountingMenu = document.getElementById('accounting-menu');
            const accountingSubmenu = document.getElementById('accounting-submenu');
            const supportMenu = document.getElementById('support-menu');
            const supportSubmenu = document.getElementById('support-submenu');

            if (accountingMenu && accountingSubmenu) {
                accountingMenu.addEventListener('click', (e) => {
                    e.preventDefault();
                    accountingMenu.classList.toggle('open');
                    accountingSubmenu.classList.toggle('open');
                });
            }

            if (supportMenu && supportSubmenu) {
                supportMenu.addEventListener('click', (e) => {
                    e.preventDefault();
                    supportMenu.classList.toggle('open');
                    supportSubmenu.classList.toggle('open');
                });
            }

            // Handle window resize
            window.addEventListener('resize', () => {
                const nowDesktop = window.innerWidth > 768;
                if (nowDesktop && !isDesktop) {
                    // Switching from mobile to desktop
                    setSidebarExpanded(true);
                    body.classList.remove('sidebar-backdrop-active');
                } else if (!nowDesktop && isDesktop) {
                    // Switching from desktop to mobile
                    body.classList.remove('sidebar-collapsed');
                    body.classList.add('sidebar-expanded');
                }
            });

            // Highlight active sidebar link and expand accounting menu if on accounting page
            const currentPath = window.location.pathname;

            // Check if on accounting pages and expand submenu
            const isOnAccountingPage = currentPath.includes('/accounting');
            if (isOnAccountingPage && accountingMenu && accountingSubmenu) {
                accountingMenu.classList.add('open');
                accountingSubmenu.classList.add('open');
            }

            if (supportMenu && supportSubmenu && currentPath.startsWith('/support')) {
                supportMenu.classList.add('open');
                supportSubmenu.classList.add('open');
            }

            // Highlight active main links
            document.querySelectorAll('.sidebar-link:not(.has-submenu)').forEach(link => {
                const href = link.getAttribute('href');
                if (href === currentPath ||
                    (href === '/incident-board' && currentPath.includes('/incident-board')) ||
                    (href === '/departments' && currentPath.includes('/departments')) ||
                    (href === '/support' && currentPath.startsWith('/support'))) {
                    link.classList.add('active');
                }
            });

            // Highlight active sublinks
            document.querySelectorAll('.sidebar-sublink').forEach(link => {
                const href = link.getAttribute('href');
                if (href === currentPath ||
                    (href === '/accounting' && currentPath === '/accounting') ||
                    (href === '/accounting/finance-config' && currentPath === '/accounting/finance-config') ||
                    (href === '/accounting/expenses-board' && currentPath === '/accounting/expenses-board') ||
                    (href === '/accounting/payment' && currentPath === '/accounting/payment') ||
                    (href === '/accounting/receipts-board' && currentPath === '/accounting/receipts-board') ||
                    (href === '/support/faqs' && currentPath === '/support/faqs')) {
                    link.classList.add('active');
                }
            });

            document.querySelectorAll('.sidebar-sublink.soon').forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (typeof Swal !== 'undefined' && Swal.fire) {
                        Swal.fire({
                            title: 'Tickets propios próximamente',
                            text: 'Esta sección aún no está disponible.',
                            icon: 'info',
                            confirmButtonText: 'Aceptar',
                            confirmButtonColor: '#6A8042'
                        });
                    }
                });
            });

            // Reduce label size when button names are long.
            document.querySelectorAll('.sidebar-link-copy strong').forEach(label => {
                if ((label.textContent || '').trim().length > 18) {
                    label.classList.add('is-long-label');
                }
            });
        });
    </script>
    <script src="/FrontEnd/JS/notifications_menu.js"></script>
</body>

</html>




