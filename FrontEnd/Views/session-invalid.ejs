<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Nunito:wght@400;600;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <title>ADI - Sesión inválida</title>
    <link rel="stylesheet" href="/FrontEnd/CSS/session_status.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
</head>

<body>
    <nav class="top-nav">
        <div class="nav-content nav-brand">
            <a href="/"><img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo"></a>
        </div>
        <div class="nav-content nav-actions">
            <a href="/login">INICIAR SESIÓN</a>
        </div>
    </nav>

    <main class="status-shell">
        <% const isTimeout = reason === 'session-ended'; %>
        <% const title = isTimeout ? 'Tu sesión terminó' : 'Sesión inválida'; %>
        <% const message = isTimeout
            ? 'Tu sesión expiró por seguridad. Vuelve a iniciar sesión para continuar.'
            : 'Sesión inválida. Inicia sesión nuevamente.'; %>

        <section class="status-card" aria-labelledby="status-title">
            <div class="status-icon" aria-hidden="true">!</div>
            <span class="status-badge"><%= isTimeout ? 'Sesión expirada' : 'Acceso bloqueado' %></span>
            <h1 id="status-title"><%= title %></h1>
            <p><%= message %></p>

            <div class="status-actions">
                <a class="primary-btn" href="/login">Ir a iniciar sesión</a>
                <a class="secondary-btn" href="/">Volver al inicio</a>
            </div>
        </section>
    </main>

    <footer>
        <p>ADI</p>
    </footer>
</body>

</html>
