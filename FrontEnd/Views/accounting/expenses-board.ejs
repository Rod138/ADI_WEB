<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/expenses_board.css">
    <link rel="stylesheet" href="/FrontEnd/CSS/accounting_common.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Tablon de Gastos</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <script src="/FrontEnd/JS/expenses_board.js" defer></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        .role-badge #user-role {
            white-space: normal;
        }
    </style>
</head>
<body data-min-role="1">
    <nav class="top-nav">
        <div class="nav-brand">
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">TABLON DE GASTOS</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesion">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <div class="main-container">
        <div class="selects">
            <div class="filter-group">
                <label for="month-filter">Periodo</label>
                <select id="month-filter">
                    <option value="any">Cualquiera</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="amount-filter">Monto</label>
                <select id="amount-filter">
                    <option value="any">Cualquiera</option>
                    <option value="lt-500">Menor a $500</option>
                    <option value="500-1000">$500 a $1000</option>
                    <option value="gt-1000">Mayor a $1000</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="order-by">Ordenar por</label>
                <select id="order-by">
                    <option value="date-desc">Fecha descendente</option>
                    <option value="date-asc">Fecha ascendente</option>
                    <option value="amount-desc">Monto descendente</option>
                    <option value="amount-asc">Monto ascendente</option>
                </select>
            </div>
            <button id="open-expense-form-btn" class="btn-create-expense" data-min-role="2" aria-label="Levantar gasto">
                <span class="material-symbols-outlined">add_circle</span>
                <span>LEVANTAR GASTO</span>
            </button>
        </div>

        <!-- Form panel para levantar gasto (oculto por defecto) -->
        <section class="expense-form-panel" id="expense-form-panel" style="display:none;">
            <div class="expense-form-header">
                <h2 id="expense-form-title">LEVANTAR GASTO</h2>
                <button id="close-expense-form-btn" class="close-form-btn" aria-label="Cerrar">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="form-grid">
                <label for="expense-amount">COSTO :</label>
                <input id="expense-amount" type="number" min="0.01" step="0.01" placeholder="$100.00" required>

                <div class="obs-row">
                    <label for="expense-notes">DESCRIPCION</label>
                    <span id="char-counter">0 / 150</span>
                </div>
                <input id="expense-notes" type="text" maxlength="150" placeholder="Describe el gasto" required>

                <label class="upload-box" for="expense-image">
                    <input id="expense-image" type="file" accept="image/*" hidden>
                    <img id="preview-image" alt="Vista previa" style="display:none">
                    <span id="upload-icon" class="material-symbols-outlined">image</span>
                    <span id="upload-name">Selecciona un comprobante</span>
                </label>

                <label class="checkbox-label">
                    <input type="checkbox" id="expense-confirm">
                    HAGO CLICK PARA CONFIRMAR
                </label>
            </div>
            <div class="form-actions-expense">
                <button id="save-expense-btn" class="btn-upload">SUBIR</button>
                <button id="cancel-expense-btn" class="btn-cancel">CANCELAR</button>
            </div>
        </section>

        <div class="table-container">
            <table>
                <colgroup>
                    <col style="width: 65%">
                    <col style="width: 20%">
                    <col style="width: 15%">
                    <col style="width: 20%">
                </colgroup>
                <thead>
                    <tr>
                        <th>Informacion</th>
                        <th>Fecha</th>
                        <th>Monto</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="expenses-tbody">
                    <tr><td colspan="4" style="text-align:center">Cargando...</td></tr>
                </tbody>
            </table>
        </div>

        <div class="pagination-controls" id="expenses-pagination" style="display:none">
            <button type="button" class="page-btn" id="exp-prev-btn">ANTERIOR</button>
            <span class="page-indicator" id="exp-page-indicator">Pagina 1 de 1</span>
            <button type="button" class="page-btn" id="exp-next-btn">SIGUIENTE</button>
        </div>

        <div class="bottom-actions">
            <a href="/accounting" class="btn-back">REGRESAR</a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const user = window.ADIAuth?.getCurrentUser?.();
            if (user) {
                const roleSpan = document.getElementById('user-role');
                if (roleSpan) roleSpan.textContent = window.ADIAuth.getRoleLabel(user.rol_id);
            }
        });
    </script>
    <footer>
        <p>X-CORP</p>
    </footer>
</body>
</html>
