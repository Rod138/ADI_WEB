<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/accounting.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Contabilidad</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
            min-width: 0;
            max-width: min(15rem, 45vw);
        }
        .role-badge span {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        .role-badge #user-role {
            display: inline-block;
            max-width: 10.5rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    </style>
</head>
<body data-min-role="2">
    <nav class="top-nav">
        <div class="nav-brand">
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">CONTABILIDAD</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <a href="/notifications" class="nav-icon-btn" aria-label="Notificaciones">
                <span class="material-symbols-outlined">notifications</span>
            </a>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesión">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <main class="main-container accounting-page">
        <section class="cards-grid" aria-label="Opciones de contabilidad">
            <a href="/accounting/payment" class="menu-card button-1">
                <span>REGISTRAR PAGO DE CUOTA</span>
            </a>
            <a href="/accounting/receipts-board" class="menu-card button-2">
                <span>REVISAR COMPROBANTE DE CUOTA</span>
            </a>
            <a href="/accounting/expense" class="menu-card button-3">
                <span>LEVANTAR GASTO</span>
            </a>
            <a href="/accounting/tower-fund" class="menu-card button-4">
                <span>CONFIGURAR FONDO INICIAL</span>
            </a>
            <a href="/accounting/monthly-quota" class="menu-card button-5">
                <span>CONFIGURAR CUOTA MENSUAL</span>
            </a>
        </section>

        <div class="bottom-actions">
            <a href="/main" class="btn-back">REGRESAR</a>
        </div>
    </main>

    <footer>
        <p>X-CORP</p>
    </footer>

    <script>
        document.querySelectorAll('.coming-soon').forEach(function (card) {
            card.addEventListener('click', function (e) {
                e.preventDefault();
                Swal.fire({
                    titleText: this.dataset.feature + ' proximamente',
                    text: 'Esta seccion aun no esta disponible.',
                    icon: 'info',
                    confirmButtonText: 'Entendido'
                });
            });
        });
    </script>
</body>
</html>







