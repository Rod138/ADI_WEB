    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        .role-badge #user-role {
            white-space: normal;
        }
        .sidebar-toggle {
            border: none;
            background: transparent;
            padding: 0;
            margin-right: 0.25rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .sidebar-toggle .material-symbols-outlined {
            font-size: 1.9rem;
        }
    </style>
</head>
<body class="sidebar-expanded" data-min-role="1">
