<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/accounting.css">
    <link rel="stylesheet" href="/FrontEnd/CSS/accounting_common.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Contabilidad</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        .role-badge #user-role {
            white-space: normal;
        }
    </style>
</head>
<body data-min-role="1">
    <nav class="top-nav">
        <div class="nav-brand">
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">CONTABILIDAD</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <a href="/notifications" class="nav-icon-btn" aria-label="Notificaciones">
                <span class="material-symbols-outlined">notifications</span>
            </a>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesión">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <main class="main-container accounting-page">
        <section class="cards-grid" aria-label="Opciones de contabilidad">
            <a href="/accounting/payment" class="menu-card button-2" id="card-my-quota">
                <div class="card-content">
                    <h2 class="card-title">MIS CUOTAS</h2>
                    <p class="card-subtitle">Consulta pagos y adeudos.</p>
                </div>
            </a>

            <a href="/accounting/expenses-board" class="menu-card button-3" id="card-expense-board">
                <div class="card-content">
                    <h2 class="card-title">GASTOS DEL CONDOMINIO</h2>
                    <p class="card-subtitle">Revisa gastos y comprobantes.</p>
                </div>
            </a>

            <a href="/accounting/receipts-board" class="menu-card button-4" data-admin-only="true">
                <div class="card-content">
                    <h2 class="card-title">CUOTAS DE RESIDENTES</h2>
                    <p class="card-subtitle">Valida comprobantes de pago.</p>
                </div>
            </a>

            <a href="/accounting/cash-payment" class="menu-card button-4" data-admin-only="true">
                <div class="card-content">
                    <h2 class="card-title">CUOTA EN EFECTIVO</h2>
                    <p class="card-subtitle">Registra una cuota ajena pagada en efectivo.</p>
                </div>
            </a>

            <a href="/accounting/finance-config" class="menu-card button-5" data-admin-only="true">
                <div class="card-content">
                    <h2 class="card-title">CONFIGURACIÓN FINANCIERA</h2>
                    <p class="card-subtitle">Ajusta fondo inicial y cuota mensual.</p>
                </div>
            </a>
        </section>

        <div class="bottom-actions">
            <a href="/main" class="btn-back">REGRESAR</a>
        </div>
    </main>

    <footer>
        <p>X-CORP</p>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const user = window.ADIAuth?.getCurrentUser?.();
            const canManage = user && Number(user.rol_id) >= 2;
            const cardsGrid = document.querySelector('.cards-grid');

            if (user) {
                const roleSpan = document.getElementById('user-role');
                if (roleSpan) roleSpan.textContent = window.ADIAuth.getRoleLabel(user.rol_id);
            }

            document.querySelectorAll('[data-admin-only="true"]').forEach((el) => {
                el.style.display = canManage ? '' : 'none';
            });

            if (cardsGrid) {
                cardsGrid.classList.remove('cards-count-1', 'cards-count-2', 'cards-count-3', 'cards-count-4', 'cards-count-5');
                const visibleCards = Array.from(cardsGrid.querySelectorAll('.menu-card')).filter((card) => {
                    return card.style.display !== 'none';
                });

                if (visibleCards.length >= 1 && visibleCards.length <= 5) {
                    cardsGrid.classList.add(`cards-count-${visibleCards.length}`);
                }
            }

        });
    </script>
</body>
</html>







