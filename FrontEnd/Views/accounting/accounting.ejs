    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <main class="main-container accounting-page">
        <section class="cards-grid" aria-label="Opciones de contabilidad">
            <a href="/accounting/payment" class="menu-card button-2" id="card-my-quota">
                <div class="card-content">
                    <h2 class="card-title">MIS CUOTAS</h2>
                    <p class="card-subtitle">Consulta pagos y adeudos.</p>
                </div>
            </a>

            <a href="/accounting/expenses-board" class="menu-card button-3" id="card-expense-board">
                <div class="card-content">
                    <h2 class="card-title">GASTOS DEL CONDOMINIO</h2>
                    <p class="card-subtitle">Revisa gastos y comprobantes.</p>
                </div>
            </a>

            <a href="/accounting/receipts-board" class="menu-card button-4" data-admin-only="true">
                <div class="card-content">
                    <h2 class="card-title">CUOTAS DE RESIDENTES</h2>
                    <p class="card-subtitle">Valida comprobantes de pago.</p>
                </div>
            </a>

            <a href="/accounting/cash-payment" class="menu-card button-4" data-admin-only="true">
                <div class="card-content">
                    <h2 class="card-title">CUOTA EN EFECTIVO</h2>
                    <p class="card-subtitle">Registra una cuota ajena pagada en efectivo.</p>
                </div>
            </a>

            <a href="/accounting/finance-config" class="menu-card button-5" data-admin-only="true">
                <div class="card-content">
                    <h2 class="card-title">CONFIGURACIÓN FINANCIERA</h2>
                    <p class="card-subtitle">Ajusta fondo inicial y cuota mensual.</p>
                </div>
            </a>
        </section>

        <div class="bottom-actions">
            <a href="/main" class="btn-back">REGRESAR</a>
        </div>
    </main>

    <footer>
        <p>X-CORP</p>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const user = window.ADIAuth?.getCurrentUser?.();
            const canManage = user && Number(user.rol_id) >= 2;
            const cardsGrid = document.querySelector('.cards-grid');

            if (user) {
                const roleSpan = document.getElementById('user-role');
                if (roleSpan) roleSpan.textContent = window.ADIAuth.getRoleLabel(user.rol_id);
            }

            document.querySelectorAll('[data-admin-only="true"]').forEach((el) => {
                el.style.display = canManage ? '' : 'none';
            });

            const currentPath = window.location.pathname;
            document.querySelectorAll('.sidebar-link').forEach((link) => {
                const href = link.getAttribute('href');
                if (href === '/accounting' && currentPath.startsWith('/accounting')) {
                    link.classList.add('active');
                }
            });
            const headerLink = document.querySelector('.sidebar-header-link');
            if (headerLink && currentPath === '/main') headerLink.classList.add('active');

            if (cardsGrid) {
                const applyCardsLayout = () => {
                    cardsGrid.classList.remove('cards-count-1', 'cards-count-2', 'cards-count-3', 'cards-count-4', 'cards-count-5');

                    const allCards = Array.from(cardsGrid.querySelectorAll('.menu-card'));
                    const visibleCards = allCards.filter((card) => card.style.display !== 'none');

                    if (visibleCards.length >= 1 && visibleCards.length <= 5) {
                        cardsGrid.classList.add(`cards-count-${visibleCards.length}`);
                    }

                    // Reset inline layout tweaks before recalculating.
                    cardsGrid.style.removeProperty('grid-template-columns');
                    allCards.forEach((card) => {
                        card.classList.remove('center-last');
                        card.style.removeProperty('grid-column');
                        card.style.removeProperty('justify-self');
                        card.style.removeProperty('width');
                    });

                    if (visibleCards.length === 0) return;

                    const lastVisible = visibleCards[visibleCards.length - 1];
                    lastVisible.classList.add('center-last');

                    if (visibleCards.length !== 5) return;

                    // Force deterministic layout for 5 cards across breakpoints.
                    const viewportWidth = window.innerWidth || document.documentElement.clientWidth;

                    // Desktop: 4 columns + last card centered on row 2.
                    if (viewportWidth > 1120) {
                        cardsGrid.style.gridTemplateColumns = 'repeat(4, minmax(0, 1fr))';
                        lastVisible.style.gridColumn = '2 / span 2';
                        lastVisible.style.justifySelf = 'center';
                        lastVisible.style.width = 'min(100%, 20rem)';
                        return;
                    }

                    // Tablet: 2 columns + last card centered full row.
                    if (viewportWidth > 672) {
                        cardsGrid.style.gridTemplateColumns = 'repeat(2, minmax(0, 1fr))';
                        lastVisible.style.gridColumn = '1 / -1';
                        lastVisible.style.justifySelf = 'center';
                        lastVisible.style.width = 'min(100%, 22rem)';
                        return;
                    }

                    // Mobile: one card per row.
                    cardsGrid.style.gridTemplateColumns = '1fr';
                };

                applyCardsLayout();
                window.removeEventListener('resize', window.__adiAccountingResizeHandler);
                window.__adiAccountingResizeHandler = applyCardsLayout;
                window.addEventListener('resize', window.__adiAccountingResizeHandler);
            }

        });
    </script>
</body>
</html>







