<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/cash_payment.css">
    <link rel="stylesheet" href="/FrontEnd/CSS/accounting_common.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Cuota en Efectivo</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <script src="/FrontEnd/JS/cash_payment.js" defer></script>
</head>
<body data-min-role="2">
    <nav class="top-nav">
        <div class="nav-brand">
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">CUOTA EN EFECTIVO</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesion">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <main class="main-container">
        <section class="cash-card">
            <h2>REGISTRAR CUOTA AJENA</h2>
            <div class="form-grid">
                <label for="cash-department">Departamento</label>
                <select id="cash-department"></select>

                <label for="cash-year">Año</label>
                <input id="cash-year" type="number" min="2000" max="2100" step="1" placeholder="2026">

                <label for="cash-month">Mes</label>
                <select id="cash-month"></select>

                <label for="cash-amount-paid">Cantidad pagada</label>
                <input id="cash-amount-paid" type="number" min="0.01" step="0.01" placeholder="Ej. 1200.00">

                <label for="cash-amount-expected">Cuota esperada</label>
                <input id="cash-amount-expected" type="number" min="0.01" step="0.01" placeholder="Ej. 1200.00" readonly>

                <label class="checkbox-label">
                    <input type="checkbox" id="cash-confirm">
                    CONFIRMO QUE EL PAGO FUE EN EFECTIVO
                </label>
            </div>

            <div class="action-row">
                <button id="cash-save-btn" class="btn-save">GUARDAR</button>
                <button id="cash-cancel-btn" class="btn-cancel">CANCELAR</button>
            </div>
        </section>

        <section class="history-card">
            <h2>REGISTROS DEL PERIODO SELECCIONADO</h2>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>DEPARTAMENTO</th>
                            <th>PERIODO</th>
                            <th>PAGADO</th>
                            <th>ESPERADO</th>
                            <th>FECHA</th>
                        </tr>
                    </thead>
                    <tbody id="cash-history-tbody">
                        <tr><td colspan="5" style="text-align:center">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <div class="bottom-actions">
            <a href="/accounting" class="btn-back">REGRESAR</a>
        </div>
    </main>

    <footer>
        <p>X-CORP</p>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const user = window.ADIAuth?.getCurrentUser?.();
            if (user) {
                const roleSpan = document.getElementById('user-role');
                if (roleSpan) roleSpan.textContent = window.ADIAuth.getRoleLabel(user.rol_id);
            }
        });
    </script>
</body>
</html>
