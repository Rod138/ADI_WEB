<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/main.css">
    <link rel="stylesheet" href="/FrontEnd/CSS/mis_quotas.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Mis Cuotas</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <script src="/FrontEnd/JS/payment.js" defer></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        .role-badge #user-role {
            white-space: normal;
        }
        .sidebar-toggle {
            border: none;
            background: transparent;
            padding: 0;
            margin-right: 0.25rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .sidebar-toggle .material-symbols-outlined {
            font-size: 1.9rem;
        }
    </style>
</head>
<body
    class="sidebar-expanded"
    data-min-role="1"
    data-cloudinary-cloud-name="<%= cloudinaryCloudName || '' %>"
    data-cloudinary-upload-preset="<%= cloudinaryUploadPreset || '' %>">
    <nav class="top-nav">
        <div class="nav-brand">
            <button type="button" class="nav-icon-btn sidebar-toggle" id="sidebar-toggle" aria-label="Alternar barra lateral" aria-expanded="true">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">MIS CUOTAS</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesion">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <aside class="adi-sidebar" id="adi-sidebar" aria-label="Barra lateral de navegación">
        <nav class="sidebar-nav" aria-label="Accesos rápidos">
            <a class="sidebar-link" href="/main" data-label="Menú principal">
                <span class="material-symbols-outlined">dashboard</span>
                <div class="sidebar-link-copy">
                    <strong>Menú principal</strong>
                </div>
            </a>
            <div class="sidebar-link has-submenu" id="accounting-menu" data-label="Finanzas">
                <span class="material-symbols-outlined">payments</span>
                <div class="sidebar-link-copy">
                    <strong>Finanzas</strong>
                </div>
                <span class="material-symbols-outlined toggle-arrow">expand_more</span>
            </div>
            <nav class="sidebar-submenu" id="accounting-submenu">
                <a class="sidebar-sublink" href="/accounting" data-label="Tablero">
                    <span class="material-symbols-outlined">dashboard</span>
                    <div class="sidebar-link-copy">
                        <strong>Finanzas</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/finance-config" data-label="Configuración">
                    <span class="material-symbols-outlined">settings</span>
                    <div class="sidebar-link-copy">
                        <strong>Configuración</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/expenses-board" data-label="Gastos">
                    <span class="material-symbols-outlined">receipt_long</span>
                    <div class="sidebar-link-copy">
                        <strong>Gastos del condominio</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/payment" data-label="Pagos">
                    <span class="material-symbols-outlined">payment</span>
                    <div class="sidebar-link-copy">
                        <strong>Mis cuotas</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/receipts-board" data-label="Recibos">
                    <span class="material-symbols-outlined">inventory_2</span>
                    <div class="sidebar-link-copy">
                        <strong>Cuotas de residentes</strong>
                    </div>
                </a>
            </nav>
            <a class="sidebar-link" href="/incident-board" data-label="Incidencias">
                <span class="material-symbols-outlined">warning</span>
                <div class="sidebar-link-copy">
                    <strong>Incidencias</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/reports" data-label="Reportes">
                <span class="material-symbols-outlined">bar_chart</span>
                <div class="sidebar-link-copy">
                    <strong>Reportes</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/departments" data-label="Departamentos">
                <span class="material-symbols-outlined">apartment</span>
                <div class="sidebar-link-copy">
                    <strong>Departamentos</strong>
                </div>
            </a>
        </nav>
    </aside>

    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <main class="main-container">
        <section class="left-form-panel">
            <div class="form-field">
                <label for="pay-month">MES CORRESPONDIENTE:</label>
                <select id="pay-month"></select>
            </div>

            <div class="form-field">
                <label for="pay-year">AÑO:</label>
                <input id="pay-year" type="number" min="2000" max="2100" step="1" placeholder="2026">
            </div>

            <div class="form-field">
                <label for="pay-amount">CANTIDAD PAGADA:</label>
                <input id="pay-amount" type="number" min="0" step="0.01" placeholder="Ej. 100.00">
            </div>

            <div class="form-field">
                <label for="pay-expected">CUOTA ESPERADA:</label>
                <input id="pay-expected" type="number" min="0" step="0.01" placeholder="Ej. 100.00" readonly>
            </div>

            <label for="pay-proof">COMPROBANTE (IMAGEN O PDF):</label>
            <label class="proof-upload-box" for="pay-proof">
                <input id="pay-proof" type="file" accept="image/*,.pdf,application/pdf" hidden>
                <span class="proof-upload-copy">
                    <span id="proof-name" class="proof-upload-name">Selecciona un archivo</span>
                    <span class="proof-upload-hint">Imagen o PDF</span>
                </span>
            </label>

            <button id="save-payment-btn" class="btn-save">GUARDAR</button>
        </section>

        <section class="right-board-panel">
            <div class="filters-box">
                <div class="filter-group">
                    <label for="flt-status">Estado</label>
                    <select id="flt-status">
                        <option value="any">Cualquiera</option>
                        <option value="pending">Pendiente</option>
                        <option value="approved">Validado</option>
                        <option value="rejected">Rechazado</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="flt-month">Mes</label>
                    <select id="flt-month">
                        <option value="any">Cualquiera</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="flt-year">Año</label>
                    <select id="flt-year">
                        <option value="any">Cualquiera</option>
                    </select>
                </div>
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>ESTADO</th>
                            <th>FECHA</th>
                            <th>PERIODO</th>
                            <th>PAGADO</th>
                            <th>ESPERADO</th>
                            <th>COMPROBANTE</th>
                        </tr>
                    </thead>
                    <tbody id="payments-tbody">
                        <tr><td colspan="6" style="text-align:center">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="pagination-controls" id="payments-pagination" style="display:none">
                <button type="button" class="page-btn" id="pay-prev-btn">ANTERIOR</button>
                <span class="page-indicator" id="pay-page-indicator">Pagina 1 de 1</span>
                <button type="button" class="page-btn" id="pay-next-btn">SIGUIENTE</button>
            </div>
        </section>
    </main>

    <div class="bottom-actions">
        <button id="download-btn" class="btn-download">DESCARGAR CSV</button>
        <a href="/accounting" class="btn-back">REGRESAR</a>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const user = window.ADIAuth?.getCurrentUser?.();
            if (user) {
                const roleSpan = document.getElementById('user-role');
                if (roleSpan) roleSpan.textContent = window.ADIAuth.getRoleLabel(user.rol_id);
            }

            // Highlight active sidebar link
            const currentPath = window.location.pathname;
            document.querySelectorAll('.sidebar-link').forEach(link => {
                const href = link.getAttribute('href');
                if (
                    (href === '/accounting' && currentPath.startsWith('/accounting')) ||
                    (href === '/incident-board' && currentPath.startsWith('/incident')) ||
                    (href === '/reports' && currentPath === '/reports') ||
                    (href === '/departments' && currentPath === '/departments')
                ) {
                    link.classList.add('active');
                }
            });
            const headerLink = document.querySelector('.sidebar-header-link');
            if (headerLink && currentPath === '/main') headerLink.classList.add('active');
        });
    </script>
    <footer>
        <p>X-CORP</p>
    </footer>
</body>
</html>









