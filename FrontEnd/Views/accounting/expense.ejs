<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/expense.css">
    <link rel="stylesheet" href="/FrontEnd/CSS/accounting_common.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
        <link rel="stylesheet" href="/FrontEnd/CSS/main.css">
    <title>ADI - Levantar Gasto</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <script src="/FrontEnd/JS/expense.js" defer></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        .role-badge #user-role {
            white-space: normal;
        }
        .sidebar-toggle {
            border: none;
            background: transparent;
            padding: 0;
            margin-right: 0.25rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .sidebar-toggle .material-symbols-outlined {
            font-size: 1.9rem;
        }
    </style>
</head>
<body class="sidebar-expanded" data-min-role="2">
    <nav class="top-nav">
        <div class="nav-brand">
            <button type="button" class="nav-icon-btn sidebar-toggle" id="sidebar-toggle" aria-label="Alternar barra lateral" aria-expanded="true">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">LEVANTAR GASTO</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <a href="/notifications" class="nav-icon-btn" aria-label="Notificaciones">
                <span class="material-symbols-outlined">notifications</span>
            </a>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesión">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <aside class="adi-sidebar" id="adi-sidebar" aria-label="Barra lateral de navegación">
        <a class="sidebar-header-link" href="/main" aria-label="Ir al Menú Principal">
            <div class="sidebar-header-icon">
                <span class="material-symbols-outlined">dashboard</span>
            </div>
            <div class="sidebar-header-copy">
                <span class="sidebar-kicker">MENÚ</span>
                <strong>PRINCIPAL</strong>
            </div>
        </a>
        <nav class="sidebar-nav" aria-label="Accesos rápidos">
            <a class="sidebar-link" href="/accounting">
                <span class="material-symbols-outlined">payments</span>
                <div class="sidebar-link-copy">
                    <strong>Finanzas</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/incident-board">
                <span class="material-symbols-outlined">warning</span>
                <div class="sidebar-link-copy">
                    <strong>Incidencias</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/reports">
                <span class="material-symbols-outlined">bar_chart</span>
                <div class="sidebar-link-copy">
                    <strong>Reportes</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/departments">
                <span class="material-symbols-outlined">apartment</span>
                <div class="sidebar-link-copy">
                    <strong>Departamentos</strong>
                </div>
            </a>
        </nav>
    </aside>

    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <main class="main-container">
        <section class="expense-card">
            <div class="form-grid">
                <label for="expense-amount">COSTO :</label>
                <input id="expense-amount" type="number" min="0.01" step="0.01" placeholder="$100.00" required>

                <div class="obs-row">
                    <label for="expense-notes">DESCRIPCION</label>
                    <span id="char-counter">0 / 150</span>
                </div>
                <input id="expense-notes" type="text" maxlength="150" placeholder="Describe el gasto" required>

                <label class="upload-box" for="expense-image">
                    <input id="expense-image" type="file" accept="image/*" hidden>
                    <img id="preview-image" alt="Vista previa" style="display:none">
                    <span id="upload-icon" class="material-symbols-outlined">image</span>
                    <span id="upload-name">Selecciona un comprobante</span>
                </label>

                <label class="checkbox-label">
                    <input type="checkbox" id="expense-confirm">
                    HAGA CLICK PARA CONFIRMAR
                </label>
            </div>
        </section>

        <div class="bottom-actions">
            <button id="save-expense-btn" class="btn-upload">SUBIR</button>
            <a href="/accounting" class="btn-back">REGRESAR</a>
        </div>
    </main>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const user = window.ADIAuth?.getCurrentUser?.();
            if (user) {
                const roleSpan = document.getElementById('user-role');
                if (roleSpan) roleSpan.textContent = window.ADIAuth.getRoleLabel(user.rol_id);
            }

            // Highlight active sidebar link
            const currentPath = window.location.pathname;
            document.querySelectorAll('.sidebar-link').forEach(link => {
                const href = link.getAttribute('href');
                if (
                    (href === '/accounting' && currentPath.startsWith('/accounting')) ||
                    (href === '/incident-board' && currentPath.startsWith('/incident')) ||
                    (href === '/reports' && currentPath === '/reports') ||
                    (href === '/departments' && currentPath === '/departments')
                ) {
                    link.classList.add('active');
                }
            });
            const headerLink = document.querySelector('.sidebar-header-link');
            if (headerLink && currentPath === '/main') headerLink.classList.add('active');
        });
    </script>
    <footer>
        <p>X-CORP</p>
    </footer>
</body>
</html>







