<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/main.css">
    <link rel="stylesheet" href="/FrontEnd/CSS/finance_config.css">
    <link rel="stylesheet" href="/FrontEnd/CSS/accounting_common.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Configuración Financiera</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <script src="/FrontEnd/JS/finance_config.js" defer></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        .role-badge #user-role {
            white-space: normal;
        }
        .sidebar-toggle {
            border: none;
            background: transparent;
            padding: 0;
            margin-right: 0.25rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .sidebar-toggle .material-symbols-outlined {
            font-size: 1.9rem;
        }
    </style>
</head>
<body class="sidebar-expanded" data-min-role="2">
    <nav class="top-nav">
        <div class="nav-brand">
            <button type="button" class="nav-icon-btn sidebar-toggle" id="sidebar-toggle" aria-label="Alternar barra lateral" aria-expanded="true">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">CONFIGURACIÓN FINANCIERA</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesion">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <aside class="adi-sidebar" id="adi-sidebar" aria-label="Barra lateral de navegación">
        <nav class="sidebar-nav" aria-label="Accesos rápidos">
            <a class="sidebar-link" href="/main" data-label="Menú principal">
                <span class="material-symbols-outlined">dashboard</span>
                <div class="sidebar-link-copy">
                    <strong>Menú principal</strong>
                </div>
            </a>
            <div class="sidebar-link has-submenu" id="accounting-menu" data-label="Finanzas">
                <span class="material-symbols-outlined">payments</span>
                <div class="sidebar-link-copy">
                    <strong>Finanzas</strong>
                </div>
                <span class="material-symbols-outlined toggle-arrow">expand_more</span>
            </div>
            <nav class="sidebar-submenu" id="accounting-submenu">
                <a class="sidebar-sublink" href="/accounting" data-label="Tablero">
                    <span class="material-symbols-outlined">dashboard</span>
                    <div class="sidebar-link-copy">
                        <strong>Finanzas</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/finance-config" data-label="Configuración">
                    <span class="material-symbols-outlined">settings</span>
                    <div class="sidebar-link-copy">
                        <strong>Configuración</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/expenses-board" data-label="Gastos">
                    <span class="material-symbols-outlined">receipt_long</span>
                    <div class="sidebar-link-copy">
                        <strong>Gastos del condominio</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/payment" data-label="Pagos">
                    <span class="material-symbols-outlined">payment</span>
                    <div class="sidebar-link-copy">
                        <strong>Mis cuotas</strong>
                    </div>
                </a>
                <a class="sidebar-sublink" href="/accounting/receipts-board" data-label="Recibos">
                    <span class="material-symbols-outlined">inventory_2</span>
                    <div class="sidebar-link-copy">
                        <strong>Cuotas de residentes</strong>
                    </div>
                </a>
            </nav>
            <a class="sidebar-link" href="/incident-board" data-label="Incidencias">
                <span class="material-symbols-outlined">warning</span>
                <div class="sidebar-link-copy">
                    <strong>Incidencias</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/reports" data-label="Reportes">
                <span class="material-symbols-outlined">bar_chart</span>
                <div class="sidebar-link-copy">
                    <strong>Reportes</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/departments" data-label="Departamentos">
                <span class="material-symbols-outlined">apartment</span>
                <div class="sidebar-link-copy">
                    <strong>Departamentos</strong>
                </div>
            </a>
        </nav>
    </aside>

    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <main class="main-container">
        <section class="balance-card">
            <h2>Balance de la Torre</h2>
            <div class="balance-display">
                <p class="balance-label">Balance Actual</p>
                <p id="current-balance" class="balance-amount">$0.00</p>
                <div class="balance-breakdown">
                    <div class="breakdown-item">
                        <span class="breakdown-label">Fondo Inicial:</span>
                        <span id="breakdown-fund" class="breakdown-value">$0.00</span>
                    </div>
                    <div class="breakdown-item">
                        <span class="breakdown-label">Pagos Recibidos:</span>
                        <span id="breakdown-payments" class="breakdown-value positive">+$0.00</span>
                    </div>
                    <div class="breakdown-item">
                        <span class="breakdown-label">Gastos Realizados:</span>
                        <span id="breakdown-expenses" class="breakdown-value negative">-$0.00</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="fund-card">
            <h2>Fondo Inicial de Torres</h2>
            <p class="current-label">Fondo actual configurado</p>
            <p id="current-fund" class="current-amount">$0.00</p>
            <p id="updated-at" class="updated-at">Sin actualizaciones registradas</p>

            <label for="fund-amount">Nuevo fondo inicial</label>
            <input id="fund-amount" type="number" min="0" step="0.01" placeholder="Ej. 25000.00">

            <label class="checkbox-label">
                <input type="checkbox" id="fund-confirm">
                HAGA CLICK PARA CONFIRMAR
            </label>

            <div class="action-row">
                <button id="save-fund-btn" class="btn-save">GUARDAR FONDO</button>
                <button id="cancel-fund-btn" class="btn-cancel">CANCELAR</button>
            </div>
        </section>

        <section class="quota-panel">
            <h2>Cuota Mensual</h2>
            <div class="form-grid">
                <label for="quota-month">Mes</label>
                <select id="quota-month"></select>

                <label for="quota-year">Año</label>
                <input id="quota-year" type="number" min="2000" max="2100" step="1" placeholder="2026">

                <label for="quota-amount">Monto de cuota</label>
                <input id="quota-amount" type="number" min="0.01" step="0.01" placeholder="Ej. 1200.00">

                <label class="checkbox-label">
                    <input type="checkbox" id="quota-confirm">
                    HAGA CLICK PARA CONFIRMAR
                </label>

                <div class="action-row">
                    <button id="save-quota-btn" class="btn-save">GUARDAR CUOTA</button>
                    <button id="cancel-quota-btn" class="btn-cancel">CANCELAR</button>
                </div>
            </div>
        </section>

        <section class="history-panel">
            <h2>Configuración Actual</h2>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>AÑO</th>
                            <th>MES</th>
                            <th>CUOTA</th>
                            <th>ACTUALIZADO</th>
                        </tr>
                    </thead>
                    <tbody id="quota-tbody">
                        <tr><td colspan="4" style="text-align:center">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <div class="bottom-actions">
            <a href="/accounting" class="btn-back">REGRESAR</a>
        </div>
    </main>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const user = window.ADIAuth?.getCurrentUser?.();
            if (user) {
                const roleSpan = document.getElementById('user-role');
                if (roleSpan) roleSpan.textContent = window.ADIAuth.getRoleLabel(user.rol_id);
            }

            // Highlight active sidebar link
            const currentPath = window.location.pathname;
            document.querySelectorAll('.sidebar-link').forEach(link => {
                const href = link.getAttribute('href');
                if (
                    (href === '/accounting' && currentPath.startsWith('/accounting')) ||
                    (href === '/incident-board' && currentPath.startsWith('/incident')) ||
                    (href === '/reports' && currentPath === '/reports') ||
                    (href === '/departments' && currentPath === '/departments')
                ) {
                    link.classList.add('active');
                }
            });
            const headerLink = document.querySelector('.sidebar-header-link');
            if (headerLink && currentPath === '/main') headerLink.classList.add('active');
        });
    </script>
    <footer>
        <p>X-CORP</p>
    </footer>
</body>
</html>
