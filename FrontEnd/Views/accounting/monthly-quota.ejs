<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/monthly_quota.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Configuracion de Cuotas Mensuales</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <script src="/FrontEnd/JS/monthly_quota.js" defer></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
            min-width: 0;
            max-width: min(15rem, 45vw);
        }
        .role-badge span {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        .role-badge #user-role {
            display: inline-block;
            max-width: 10.5rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    </style>
</head>
<body data-min-role="2">
    <nav class="top-nav">
        <div class="nav-brand">
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">CUOTA MENSUAL</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesion">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <main class="main-container">
        <section class="quota-panel">
            <div class="form-grid">
                <label for="quota-month">Mes</label>
                <select id="quota-month"></select>

                <label for="quota-year">Año</label>
                <input id="quota-year" type="number" min="2000" max="2100" step="1" placeholder="2026">

                <label for="quota-amount">Monto de cuota</label>
                <input id="quota-amount" type="number" min="0.01" step="0.01" placeholder="Ej. 1200.00">

                <label class="checkbox-label">
                    <input type="checkbox" id="quota-confirm">
                    HAGA CLICK PARA CONFIRMAR
                </label>

                <button id="save-quota-btn" class="btn-save">GUARDAR</button>
            </div>
        </section>

        <section class="history-panel">
            <h2>Configuracion actual</h2>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>AÑO</th>
                            <th>MES</th>
                            <th>CUOTA</th>
                            <th>ACTUALIZADO</th>
                        </tr>
                    </thead>
                    <tbody id="quota-tbody">
                        <tr><td colspan="4" style="text-align:center">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <div class="bottom-actions">
            <a href="/accounting" class="btn-back">REGRESAR</a>
        </div>
    </main>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const user = window.ADIAuth?.getCurrentUser?.();
            if (user) {
                const roleSpan = document.getElementById('user-role');
                if (roleSpan) roleSpan.textContent = window.ADIAuth.getRoleLabel(user.rol_id);
            }
        });
    </script>
</body>
</html>









