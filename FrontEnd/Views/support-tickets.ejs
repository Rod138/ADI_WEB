<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/main.css">
    <link rel="stylesheet" href="/FrontEnd/CSS/support_tickets.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Tickets propios</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
</head>
<body class="sidebar-expanded support-page" data-min-role="1">
    <nav class="top-nav">
        <div class="nav-brand">
            <button type="button" class="nav-icon-btn sidebar-toggle" id="sidebar-toggle" aria-label="Alternar barra lateral" aria-expanded="true">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">TICKETS PROPIOS</div>
        <div class="nav-actions">
            <div class="role-badge"><span></span><span id="user-role">Rol</span></div>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesión">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <aside class="adi-sidebar" id="adi-sidebar" aria-label="Barra lateral de navegación">
        <nav class="sidebar-nav" aria-label="Accesos rápidos">
            <a class="sidebar-link" href="/main" data-label="Menú principal">
                <span class="material-symbols-outlined">dashboard</span>
                <div class="sidebar-link-copy"><strong>Menú principal</strong></div>
            </a>
            <div class="sidebar-link has-submenu" id="accounting-menu" data-label="Finanzas">
                <span class="material-symbols-outlined">payments</span>
                <div class="sidebar-link-copy"><strong>Finanzas</strong></div>
                <span class="material-symbols-outlined toggle-arrow">expand_more</span>
            </div>
            <nav class="sidebar-submenu" id="accounting-submenu">
                <a class="sidebar-sublink" href="/accounting" data-label="Tablero"><span class="material-symbols-outlined">dashboard</span><div class="sidebar-link-copy"><strong>Finanzas</strong></div></a>
                <a class="sidebar-sublink" href="/accounting/finance-config" data-label="Configuración"><span class="material-symbols-outlined">settings</span><div class="sidebar-link-copy"><strong>Configuración</strong></div></a>
                <a class="sidebar-sublink" href="/accounting/expenses-board" data-label="Gastos"><span class="material-symbols-outlined">receipt_long</span><div class="sidebar-link-copy"><strong>Gastos del condominio</strong></div></a>
                <a class="sidebar-sublink" href="/accounting/payment" data-label="Pagos"><span class="material-symbols-outlined">payment</span><div class="sidebar-link-copy"><strong>Mis cuotas</strong></div></a>
                <a class="sidebar-sublink" href="/accounting/receipts-board" data-label="Recibos"><span class="material-symbols-outlined">inventory_2</span><div class="sidebar-link-copy"><strong>Cuotas de residentes</strong></div></a>
            </nav>
            <a class="sidebar-link" href="/incident-board" data-label="Incidencias"><span class="material-symbols-outlined">warning</span><div class="sidebar-link-copy"><strong>Incidencias</strong></div></a>
            <a class="sidebar-link" href="/reports" data-label="Reportes"><span class="material-symbols-outlined">bar_chart</span><div class="sidebar-link-copy"><strong>Reportes</strong></div></a>
            <a class="sidebar-link" href="/departments" data-label="Departamentos"><span class="material-symbols-outlined">apartment</span><div class="sidebar-link-copy"><strong>Departamentos</strong></div></a>
            <div class="sidebar-link has-submenu open" id="support-menu" data-label="Soporte"><span class="material-symbols-outlined">support_agent</span><div class="sidebar-link-copy"><strong>Soporte</strong></div><span class="material-symbols-outlined toggle-arrow">expand_more</span></div>
            <nav class="sidebar-submenu open" id="support-submenu">
                <a class="sidebar-sublink" href="/support" data-label="Centro de ayuda"><span class="material-symbols-outlined">space_dashboard</span><div class="sidebar-link-copy"><strong>Centro de ayuda</strong></div></a>
                <a class="sidebar-sublink" href="/support/faqs" data-label="Preguntas frecuentes"><span class="material-symbols-outlined">quiz</span><div class="sidebar-link-copy"><strong>Preguntas frecuentes</strong></div></a>
                <a class="sidebar-sublink" href="/support/tickets" data-label="Tickets propios"><span class="material-symbols-outlined">confirmation_number</span><div class="sidebar-link-copy"><strong>Tickets propios</strong></div></a>
            </nav>
        </nav>
    </aside>

    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <main class="main-container support-shell">
        <section class="support-hero">
            <div class="support-hero__copy">
                <span class="eyebrow">Soporte personal</span>
                <h1>Tus tickets, en un solo lugar</h1>
                <p>
                    Crea solicitudes de ayuda con su área y tipo de error, y revisa el estado,
                    prioridad y resolución sin perder el contexto.
                </p>
            </div>
            <div class="support-hero__stats" id="ticket-stats">
                <article class="support-stat">
                    <span class="support-stat__label">Total</span>
                    <strong class="support-stat__value" data-stat="total">0</strong>
                </article>
                <article class="support-stat">
                    <span class="support-stat__label">Pendientes</span>
                    <strong class="support-stat__value" data-stat="pending">0</strong>
                </article>
                <article class="support-stat">
                    <span class="support-stat__label">Cerrados</span>
                    <strong class="support-stat__value" data-stat="closed">0</strong>
                </article>
            </div>
        </section>

        <section class="support-grid">
            <article class="support-panel support-panel--form">
                <div class="panel-heading">
                    <div>
                        <span class="panel-kicker">Nuevo ticket</span>
                        <h2>Crear solicitud</h2>
                    </div>
                    <button type="button" class="ghost-action" id="refresh-form-btn">Actualizar catálogos</button>
                </div>

                <form id="create-ticket-form" class="ticket-form">
                    <div class="field-row">
                        <label for="area_id">Área</label>
                        <select id="area_id" name="area_id" required>
                            <option value="">Selecciona un área</option>
                        </select>
                    </div>

                    <div class="field-row">
                        <label for="error_type_id">Tipo de error</label>
                        <select id="error_type_id" name="error_type_id" required disabled>
                            <option value="">Selecciona un área primero</option>
                        </select>
                    </div>

                    <div class="field-row">
                        <label for="description">Descripción</label>
                        <textarea id="description" name="description" rows="5" maxlength="250" placeholder="Describe el problema con detalle" required></textarea>
                        <div class="field-meta">
                            <span>Sea claro y concreto para acelerar la atención.</span>
                            <span id="desc-counter">0/250</span>
                        </div>
                    </div>

                    <div class="field-row">
                        <label for="evidence_url">URL de evidencia (opcional)</label>
                        <input id="evidence_url" name="evidence_url" type="url" placeholder="https://ejemplo.com/evidencia" autocomplete="off">
                        <div class="field-meta">
                            <span>Adjunta evidencia si es relevante (captura, PDF, enlace, etc.)</span>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="primary-action" id="submit-ticket-btn">Enviar ticket</button>
                    </div>
                </form>
            </article>

            <article class="support-panel support-panel--list">
                <div class="panel-heading panel-heading--list">
                    <div>
                        <span class="panel-kicker">Historial</span>
                        <h2>Tickets creados</h2>
                    </div>
                    <button type="button" class="ghost-action" id="refresh-list-btn">Recargar</button>
                </div>

                <div id="tickets-list" class="tickets-list" aria-live="polite">
                    <div class="tickets-state">Cargando tickets...</div>
                </div>
            </article>
        </section>

        <div class="support-footer-actions">
            <a href="/support" class="btn-back">REGRESAR</a>
        </div>
    </main>

    <script src="/FrontEnd/JS/support-tickets.js"></script>
</body>
</html>
