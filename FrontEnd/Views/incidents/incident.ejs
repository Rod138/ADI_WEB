<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/main.css">
    <link rel="stylesheet" href="/FrontEnd/CSS/incident.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Incidencia</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        .role-badge #user-role {
            white-space: normal;
        }
        @media (max-width: 52rem) {
            .role-badge {
                display: none;
            }
        }
    </style>
</head>
<body class="sidebar-expanded" data-min-role="1"
    data-cloudinary-cloud-name="<%= cloudinaryCloudName || '' %>"
    data-cloudinary-upload-preset="<%= cloudinaryUploadPreset || ''%>">
    <nav class="top-nav">
        <div class="nav-brand">
            <button type="button" class="nav-icon-btn sidebar-toggle" id="sidebar-toggle" aria-label="Alternar barra lateral" aria-expanded="true">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title" id="nav-title">INSPECCIONAR INCIDENCIA</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesión">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <aside class="adi-sidebar" id="adi-sidebar" aria-label="Barra lateral de navegación">
        <nav class="sidebar-nav" aria-label="Accesos rápidos">
            <a class="sidebar-link" href="/main" data-label="Menú principal">
                <span class="material-symbols-outlined">dashboard</span>
                <div class="sidebar-link-copy">
                    <strong>Menú principal</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/accounting" data-label="Finanzas">
                <span class="material-symbols-outlined">payments</span>
                <div class="sidebar-link-copy">
                    <strong>Finanzas</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/incident-board" data-label="Incidencias">
                <span class="material-symbols-outlined">warning</span>
                <div class="sidebar-link-copy">
                    <strong>Incidencias</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/reports" data-label="Reportes">
                <span class="material-symbols-outlined">bar_chart</span>
                <div class="sidebar-link-copy">
                    <strong>Reportes</strong>
                </div>
            </a>
            <a class="sidebar-link" href="/departments" data-label="Departamentos">
                <span class="material-symbols-outlined">apartment</span>
                <div class="sidebar-link-copy">
                    <strong>Departamentos</strong>
                </div>
            </a>
        </nav>
    </aside>

    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <div class="main-container">
        <div class="incident-card" id="incident-card">
            <p style="text-align:center">Cargando...</p>
        </div>
        <div class="bottom-actions">
            <a href="/incident-board" class="btn-back">REGRESAR</a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const user = window.ADIAuth?.getCurrentUser?.();
            if (user) {
                const roleSpan = document.getElementById('user-role');
                if (roleSpan) roleSpan.textContent = window.ADIAuth.getRoleLabel(user.rol_id);
            }

            // Highlight active sidebar link
            const currentPath = window.location.pathname;
            document.querySelectorAll('.sidebar-link').forEach(link => {
                const href = link.getAttribute('href');
                if (
                    (href === '/accounting' && currentPath.startsWith('/accounting')) ||
                    (href === '/incident-board' && currentPath.startsWith('/incident')) ||
                    (href === '/reports' && currentPath === '/reports') ||
                    (href === '/departments' && currentPath === '/departments') ||
                    (href === '/main' && currentPath === '/main')
                ) {
                    link.classList.add('active');
                }
            });
        });
        (async () => {
            const params = new URLSearchParams(window.location.search);
            const id = params.get('id');
            const card = document.getElementById('incident-card');
                const userStr = sessionStorage.getItem('user');
                const user = userStr ? JSON.parse(userStr) : null;

            if (!id) {
                card.innerHTML = '<p class="error">No se especificó una incidencia.</p>';
                return;
            }

            try {
                const res  = await fetch(`/api/incidents/${encodeURIComponent(id)}`);
                const data = await res.json();

                if (!data.success) {
                    card.innerHTML = '<p class="error">No se pudo cargar la incidencia.</p>';
                    return;
                }

                const inc = data.incident;
                const isAdmin = user && Number(user.rol_id) >= 3;
                const isOwner = user && Number(user.id) === Number(inc.usr_id);

                // Verificar si la incidencia tiene más de 1 mes
                const createdAt = new Date(inc.created_at);
                const now = new Date();
                const hoursDiff = (now - createdAt) / (1000 * 60 * 60);
                const isOlderThan1Month = hoursDiff >= 720; // 30 días * 24 horas
                
                // Solo el dueño puede editar dentro de 24 horas
                const canEditReport = isOwner && !isOlderThan1Month;
                const canResolve = false; // Los admins ya no pueden editar incidencias
                const canDelete = isOwner && !isOlderThan1Month;
                const canManageImage = canEditReport;
                const canShowUpdateSection = canEditReport || canResolve;

                document.getElementById('nav-title').textContent = canShowUpdateSection ? 'EDITAR / RESOLVER INCIDENCIA' : 'INSPECCIONAR INCIDENCIA';
                const date = inc.created_at
                    ? new Date(inc.created_at).toLocaleString('es-MX', {
                        year: 'numeric', month: 'long', day: 'numeric',
                        hour: '2-digit', minute: '2-digit'
                    })
                    : '-';

                const imageUrl = inc.image_url ?? inc.img_url ?? inc.cloudinary_url ?? inc.image ?? null;
                const costText = (inc.cost !== null && inc.cost !== undefined) ? `$${parseFloat(inc.cost).toFixed(2)}` : '-';
                const currentCostValue = (inc.cost !== null && inc.cost !== undefined && inc.cost !== '') ? String(inc.cost) : '';
                const descriptionText = escapeHtml(inc.content ?? inc.description ?? '-');
                const notesText = escapeHtml(inc.notes ?? '');
                const sortedStatuses = (data.statuses ?? []).slice().sort((a, b) => a.id - b.id);
                const statusOptions = sortedStatuses.map(s => {
                    const name = escapeHtml(s.name ?? s.status ?? s.id);
                    const sel = String(s.id) === String(inc.status_id) ? 'selected' : '';
                    return `<option value="${s.id}" ${sel}>${name}</option>`;
                }).join('');

                card.innerHTML = `
                    <div class="section-title">INFORMACIÓN DE LA INCIDENCIA :</div>

                    <div class="image-box">
                        ${imageUrl
                            ? `<img src="${escapeHtml(imageUrl)}" alt="Imagen de la incidencia" class="openable-image" data-image="${escapeHtml(imageUrl)}">`
                            : `<span class="material-symbols-outlined">image</span>`}
                    </div>

                    ${canManageImage ? `
                    <div class="image-actions">
                        <label for="upd-image" class="image-btn edit-image-btn">CAMBIAR IMAGEN</label>
                        <input type="file" id="upd-image" accept="image/*" style="display:none;">
                        ${imageUrl ? `<button type="button" class="delete-image-btn" id="delete-image-btn">ELIMINAR IMAGEN</button>` : ''}
                    </div>
                    ` : ''}

                    <div class="info-grid">
                        <label>REPORTADO POR :</label>
                        <input type="text" value="${escapeHtml(data.userName ?? '-')}" readonly>

                        <label>FECHA</label>
                        <input type="text" value="${date}" readonly>

                        <label>ÁREA</label>
                        <input type="text" value="${escapeHtml(data.areaName)}" readonly id="view-area">

                        <label>COSTO</label>
                        <input type="text" value="${costText}" readonly>

                        <label>DESCRIPCIÓN</label>
                        <input type="text" value="${descriptionText}" readonly>
                    </div>

                    ${canShowUpdateSection ? `
                    <div class="update-section">
                        ${canEditReport ? `
                            <div class="update-title">ACTUALIZAR REPORTE :</div>
                            <div class="update-row">
                                <label for="upd-description">DESCRIPCIÓN</label>
                                <textarea id="upd-description" maxlength="100">${descriptionText}</textarea>
                            </div>

                            <div class="update-row two-cols">
                                <div>
                                    <label for="upd-area">ÁREA</label>
                                    <select id="upd-area">
                                        ${(data.areas ?? []).map(a => {
                                            const sel = String(a.id) === String(inc.area_id) ? 'selected' : '';
                                            return `<option value="${a.id}" ${sel}>${escapeHtml(a.name)}</option>`;
                                        }).join('')}
                                    </select>
                                </div>
                                <div>
                                    <label for="upd-type">TIPO</label>
                                    <select id="upd-type">
                                        ${(data.types ?? []).map(t => {
                                            const sel = String(t.id) === String(inc.type_id) ? 'selected' : '';
                                            return `<option value="${t.id}" ${sel}>${escapeHtml(t.name)}</option>`;
                                        }).join('')}
                                    </select>
                                </div>
                            </div>

                            <div class="button-row">
                                <button class="update-btn" id="update-report-btn">GUARDAR CAMBIOS DEL REPORTE</button>
                            </div>
                        ` : ''}

                        ${canResolve ? `
                            <div class="update-title">RESOLUCIÓN (ADMINISTRADOR) :</div>
                            <div class="update-row two-cols">
                                <div>
                                    <label for="upd-status">ESTADO</label>
                                    <select id="upd-status">${statusOptions}</select>
                                </div>
                                <div>
                                    <label for="upd-cost">COSTO</label>
                                    <input type="number" id="upd-cost" min="0" step="0.0001" placeholder="0.00" value="${currentCostValue}">
                                </div>
                            </div>
                            <div class="update-row">
                                <label for="upd-notes">NOTAS <span id="char-counter">${notesText.length} / 150</span></label>
                                <input type="text" id="upd-notes" maxlength="150" value="${notesText}" placeholder="Observaciones adicionales (opcional)">
                            </div>
                            <div class="button-row">
                                <button class="update-btn" id="resolve-btn">GUARDAR RESOLUCIÓN</button>
                            </div>
                        ` : ''}

                        ${canDelete ? `
                        <div class="button-row">
                            <button type="button" class="delete-btn" id="delete-btn">ELIMINAR</button>
                        </div>
                        ` : ''}
                    </div>
                    ` : ''}
                `;

                const openableImage = card.querySelector('.openable-image');
                if (openableImage) {
                    openableImage.addEventListener('click', () => {
                        Swal.fire({
                            title: 'Imagen de la incidencia',
                            imageUrl: openableImage.dataset.image,
                            imageAlt: 'Imagen de la incidencia',
                            confirmButtonColor: '#6A8042',
                            confirmButtonText: 'Cerrar'
                        });
                    });
                }

                if (canEdit) {
                    const patchIncident = async (body, successMessage = 'Reporte actualizado correctamente.') => {
                        try {
                            const r = await fetch(`/api/incidents/${encodeURIComponent(id)}`, {
                                method: 'PATCH',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(body)
                            });
                            const result = await r.json();
                            if (result.success) {
                                await Swal.fire({
                                    title: 'Actualizado',
                                    text: successMessage,
                                    icon: 'success',
                                    timer: 1800,
                                    timerProgressBar: true,
                                    showConfirmButton: false,
                                    confirmButtonColor: '#6A8042'
                                });
                                window.location.reload();
                                return;
                            }
                            Swal.fire({
                                title: 'Error',
                                text: result.message ?? 'No se pudo actualizar.',
                                icon: 'error',
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'Aceptar'
                            });
                        } catch {
                            Swal.fire({
                                title: 'Error',
                                text: 'Fallo de red.',
                                icon: 'error',
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'Aceptar'
                            });
                        }
                    };

                    const updateReportBtn = document.getElementById('update-report-btn');
                    if (updateReportBtn) {
                        updateReportBtn.addEventListener('click', async () => {
                            // Verificar que el usuario actual es el propietario
                            if (!isOwner) {
                                Swal.fire({
                                    title: 'No permitido',
                                    text: 'Solo puedes editar tus propias incidencias.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                return;
                            }

                            const description = document.getElementById('upd-description')?.value?.trim() || '';
                            const area_id = document.getElementById('upd-area')?.value;
                            const type_id = document.getElementById('upd-type')?.value;

                            if (!description) {
                                Swal.fire({
                                    title: 'Campo requerido',
                                    text: 'La descripción es obligatoria.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                return;
                            }

                            if (description.length > 100) {
                                Swal.fire({
                                    title: 'Descripción demasiado larga',
                                    text: 'La descripción debe tener máximo 100 caracteres.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                return;
                            }

                            await patchIncident({ description, area_id, type_id });
                        });
                    }

                    const resolveBtn = document.getElementById('resolve-btn');
                    if (resolveBtn) {
                        const notesInput = document.getElementById('upd-notes');
                        const counter = document.getElementById('char-counter');
                        if (notesInput && counter) {
                            notesInput.addEventListener('input', () => {
                                counter.textContent = `${notesInput.value.length} / 150`;
                            });
                        }

                        resolveBtn.addEventListener('click', async () => {
                            const status_id = document.getElementById('upd-status')?.value;
                            const notes = document.getElementById('upd-notes')?.value?.trim() || '';
                            const costVal = document.getElementById('upd-cost')?.value ?? '';
                            
                            // Obtener el nombre del status seleccionado para detectar si es "Completado"
                            const statusSelect = document.getElementById('upd-status');
                            const selectedStatusName = statusSelect?.options[statusSelect?.selectedIndex]?.text?.toLowerCase() || '';
                            const isCompletedStatus = selectedStatusName.includes('completado') || selectedStatusName.includes('validado');
                            
                            if (isCompletedStatus && costVal === '') {
                                Swal.fire({
                                    title: 'Costo requerido',
                                    text: 'Debes capturar el costo antes de marcar como completado.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                return;
                            }

                            if (costVal !== '' && parseFloat(costVal) < 0) {
                                Swal.fire({
                                    title: 'Costo inválido',
                                    text: 'El costo no puede ser negativo.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                return;
                            }

                            const body = { status_id };
                            if (notes) body.notes = notes;
                            if (costVal !== '') body.cost = costVal;
                            if (isCompletedStatus) body.set_completed_at = true;

                            await patchIncident(body, 'Resolución actualizada correctamente.');
                        });
                    }

                    const deleteBtn = document.getElementById('delete-btn');
                    if (deleteBtn) {
                        deleteBtn.addEventListener('click', async () => {
                            // Verificar que el usuario actual es el propietario
                            if (!isOwner) {
                                Swal.fire({
                                    title: 'No permitido',
                                    text: 'Solo puedes eliminar tus propias incidencias.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                return;
                            }

                            // Validar 1 mes para propietarios
                            if (isOlderThan1Month) {
                                Swal.fire({
                                    title: 'Acción no permitida',
                                    text: 'Solo puedes eliminar la incidencia dentro de 1 mes de su creación.',
                                    icon: 'warning',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                return;
                            }

                            const confirm = await Swal.fire({
                                title: '¿Eliminar incidencia?',
                                text: 'Esta acción no se puede deshacer',
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#dc3545',
                                confirmButtonText: 'Sí, eliminar',
                                cancelButtonText: 'Cancelar'
                            });

                            if (confirm.isConfirmed) {
                                try {
                                    const r = await fetch(`/api/incidents/${encodeURIComponent(id)}`, {
                                        method: 'DELETE',
                                        headers: { 'Content-Type': 'application/json' }
                                    });
                                    const result = await r.json();
                                    if (result.success) {
                                        await Swal.fire({
                                            title: 'Eliminada',
                                            text: 'Incidencia eliminada correctamente.',
                                            icon: 'success',
                                            timer: 1800,
                                            timerProgressBar: true,
                                            showConfirmButton: false,
                                            confirmButtonColor: '#6A8042'
                                        });
                                        window.location.href = '/incident-board';
                                    } else {
                                        Swal.fire({
                                            title: 'Error',
                                            text: result.message ?? 'No se pudo eliminar.',
                                            icon: 'error',
                                            confirmButtonColor: '#d33',
                                            confirmButtonText: 'Aceptar'
                                        });
                                    }
                                } catch {
                                    Swal.fire({
                                        title: 'Error',
                                        text: 'Fallo de red.',
                                        icon: 'error',
                                        confirmButtonColor: '#d33',
                                        confirmButtonText: 'Aceptar'
                                    });
                                }
                            }
                        });
                    }

                    // Manejo de imagen
                    const imageInput = document.getElementById('upd-image');
                    const CLOUDINARY_CLOUD_NAME = document.body.dataset.cloudinaryCloudName || '';
                    const CLOUDINARY_UPLOAD_PRESET = document.body.dataset.cloudinaryUploadPreset || '';
                    const CLOUDINARY_IMAGE_UPLOAD_URL = CLOUDINARY_CLOUD_NAME
                        ? `https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD_NAME}/image/upload`
                        : '';

                    if (imageInput) {
                        imageInput.addEventListener('change', async (e) => {
                            // Verificar que el usuario actual es el propietario
                            if (!isOwner) {
                                Swal.fire({
                                    title: 'No permitido',
                                    text: 'Solo puedes editar tus propias incidencias.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                e.target.value = '';
                                return;
                            }

                            const file = e.target.files[0];
                            if (!file) return;

                            if (file.size > 5 * 1024 * 1024) {
                                Swal.fire({
                                    title: 'Archivo muy grande',
                                    text: 'La imagen no debe superar 5MB.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                return;
                            }

                            if (!CLOUDINARY_IMAGE_UPLOAD_URL || !CLOUDINARY_UPLOAD_PRESET) {
                                Swal.fire({
                                    title: 'Error',
                                    text: 'No está configurado el servicio de imágenes.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                return;
                            }

                            try {
                                const formData = new FormData();
                                formData.append('file', file);
                                formData.append('upload_preset', CLOUDINARY_UPLOAD_PRESET);

                                const uploadRes = await fetch(CLOUDINARY_IMAGE_UPLOAD_URL, {
                                    method: 'POST',
                                    body: formData
                                });

                                const uploadData = await uploadRes.json();

                                if (uploadData.secure_url) {
                                    // Enviar URL a backend
                                    const r = await fetch(`/api/incidents/${encodeURIComponent(id)}/image`, {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ image_url: uploadData.secure_url })
                                    });
                                    const result = await r.json();
                                    if (result.success) {
                                        await Swal.fire({
                                            title: 'Actualizado',
                                            text: 'Imagen actualizada correctamente.',
                                            icon: 'success',
                                            timer: 1800,
                                            timerProgressBar: true,
                                            showConfirmButton: false,
                                            confirmButtonColor: '#6A8042'
                                        });
                                        window.location.reload();
                                    } else {
                                        Swal.fire({
                                            title: 'Error',
                                            text: result.message ?? 'No se pudo actualizar la imagen.',
                                            icon: 'error',
                                            confirmButtonColor: '#d33',
                                            confirmButtonText: 'Aceptar'
                                        });
                                    }
                                } else {
                                    throw new Error('No se recibió URL de la imagen');
                                }
                            } catch {
                                Swal.fire({
                                    title: 'Error',
                                    text: 'Fallo al subir la imagen.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                            }
                        });
                    }

                    const deleteImageBtn = document.getElementById('delete-image-btn');
                    if (deleteImageBtn) {
                        deleteImageBtn.addEventListener('click', async () => {
                            // Verificar que el usuario actual es el propietario
                            if (!isOwner) {
                                Swal.fire({
                                    title: 'No permitido',
                                    text: 'Solo puedes editar tus propias incidencias.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                return;
                            }

                            const confirm = await Swal.fire({
                                title: '¿Eliminar imagen?',
                                text: 'Se eliminará la imagen de la incidencia.',
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#dc3545',
                                confirmButtonText: 'Sí, eliminar',
                                cancelButtonText: 'Cancelar'
                            });

                            if (confirm.isConfirmed) {
                                try {
                                    const r = await fetch(`/api/incidents/${encodeURIComponent(id)}/image`, {
                                        method: 'DELETE',
                                        headers: { 'Content-Type': 'application/json' }
                                    });
                                    const result = await r.json();
                                    if (result.success) {
                                        await Swal.fire({
                                            title: 'Eliminada',
                                            text: 'Imagen eliminada correctamente.',
                                            icon: 'success',
                                            timer: 1800,
                                            timerProgressBar: true,
                                            showConfirmButton: false,
                                            confirmButtonColor: '#6A8042'
                                        });
                                        window.location.reload();
                                    } else {
                                        Swal.fire({
                                            title: 'Error',
                                            text: result.message ?? 'No se pudo eliminar la imagen.',
                                            icon: 'error',
                                            confirmButtonColor: '#d33',
                                            confirmButtonText: 'Aceptar'
                                        });
                                    }
                                } catch {
                                    Swal.fire({
                                        title: 'Error',
                                        text: 'Fallo de red al eliminar la imagen.',
                                        icon: 'error',
                                        confirmButtonColor: '#d33',
                                        confirmButtonText: 'Aceptar'
                                    });
                                }
                            }
                        });
                    }
                }

            } catch (e) {
                card.innerHTML = '<p class="error">Error al cargar la incidencia.</p>';
            }

            function escapeHtml(str) {
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }
        })();
    </script>
    <footer>
        <p>X-CORP</p>
    </footer>
</body>
</html>









