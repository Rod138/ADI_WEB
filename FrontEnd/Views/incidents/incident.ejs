<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/incident.css">
    <link rel="icon" type="image/png" href="/FrontEnd/IMG/favicon.png">
    <title>ADI - Incidencia</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        .role-badge #user-role {
            white-space: normal;
        }
    </style>
</head>
<body data-min-role="1">
    <nav class="top-nav">
        <div class="nav-brand">
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title" id="nav-title">INSPECCIONAR INCIDENCIA</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesión">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>

    <div class="main-container">
        <div class="incident-card" id="incident-card">
            <p style="text-align:center">Cargando...</p>
        </div>
        <div class="bottom-actions">
            <a href="/incident-board" class="btn-back">Regresar</a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const user = window.ADIAuth?.getCurrentUser?.();
            if (user) {
                const roleSpan = document.getElementById('user-role');
                if (roleSpan) roleSpan.textContent = window.ADIAuth.getRoleLabel(user.rol_id);
            }
        });
        (async () => {
            const params = new URLSearchParams(window.location.search);
            const id = params.get('id');
            const card = document.getElementById('incident-card');
            const user = JSON.parse(sessionStorage.getItem('user'));

            if (!id) {
                card.innerHTML = '<p class="error">No se especificó una incidencia.</p>';
                return;
            }

            try {
                const res  = await fetch(`/api/incidents/${encodeURIComponent(id)}`);
                const data = await res.json();

                if (!data.success) {
                    card.innerHTML = '<p class="error">No se pudo cargar la incidencia.</p>';
                    return;
                }

                const inc = data.incident;
                const isAdmin = user && Number(user.rol_id) >= 3;
                const isOwner = user && Number(user.id) === Number(inc.usr_id);
                const canEdit = isAdmin || isOwner;
                const canDelete = isAdmin || isOwner;

                document.getElementById('nav-title').textContent = canEdit ? 'EDITAR INCIDENCIA' : 'INSPECCIONAR INCIDENCIA';
                const date = inc.created_at
                    ? new Date(inc.created_at).toLocaleString('es-MX', {
                        year: 'numeric', month: 'long', day: 'numeric',
                        hour: '2-digit', minute: '2-digit'
                    })
                    : '-';

                const imageUrl = inc.image_url ?? inc.img_url ?? inc.cloudinary_url ?? inc.image ?? null;
                const costText = (inc.cost !== null && inc.cost !== undefined) ? `$${parseFloat(inc.cost).toFixed(2)}` : '-';
                const descriptionText = escapeHtml(inc.content ?? inc.description ?? '-');
                const notesText = escapeHtml(inc.notes ?? '');
                const sortedStatuses = (data.statuses ?? []).slice().sort((a, b) => a.id - b.id);
                const statusOptions = sortedStatuses.map(s => {
                    const name = escapeHtml(s.name ?? s.status ?? s.id);
                    const sel = String(s.id) === String(inc.status_id) ? 'selected' : '';
                    return `<option value="${s.id}" ${sel}>${name}</option>`;
                }).join('');

                card.innerHTML = `
                    <div class="section-title">INFORMACIÓN DE LA INCIDENCIA :</div>

                    <div class="image-box">
                        ${imageUrl
                            ? `<img src="${escapeHtml(imageUrl)}" alt="Imagen de la incidencia">`
                            : `<span class="material-symbols-outlined">image</span>`}
                    </div>

                    <div class="info-grid">
                        <label>REPORTADO POR :</label>
                        <input type="text" value="${escapeHtml(data.userName ?? '-')}" readonly>

                        <label>FECHA</label>
                        <input type="text" value="${date}" readonly>

                        <label>ÁREA</label>
                        <input type="text" value="${escapeHtml(data.areaName)}" readonly id="view-area">

                        <label>COSTO</label>
                        <input type="text" value="${costText}" readonly>

                        <label>DESCRIPCIÓN</label>
                        <input type="text" value="${descriptionText}" readonly>
                    </div>

                    ${canEdit ? `
                    <div class="update-section">
                        <div class="update-title">${isAdmin ? 'ACTUALIZAR REPORTE (ADMINISTRADOR)' : 'ACTUALIZAR REPORTE'} :</div>

                        ${!isAdmin ? `
                            <!-- Solo para Owners (no-admin) -->
                            <div class="update-row">
                                <label for="upd-description">DESCRIPCIÓN</label>
                                <textarea id="upd-description" style="height: 80px; font-size: 0.9rem;">${descriptionText}</textarea>
                            </div>

                            <div class="update-row two-cols">
                                <div>
                                    <label for="upd-area">ÁREA</label>
                                    <select id="upd-area">
                                        ${(data.areas ?? []).map(a => {
                                            const sel = String(a.id) === String(inc.area_id) ? 'selected' : '';
                                            return `<option value="${a.id}" ${sel}>${escapeHtml(a.name)}</option>`;
                                        }).join('')}
                                    </select>
                                </div>
                                <div>
                                    <label for="upd-type">TIPO</label>
                                    <select id="upd-type">
                                        ${(data.types ?? []).map(t => {
                                            const sel = String(t.id) === String(inc.type_id) ? 'selected' : '';
                                            return `<option value="${t.id}" ${sel}>${escapeHtml(t.name)}</option>`;
                                        }).join('')}
                                    </select>
                                </div>
                            </div>

                            <div class="button-row">
                                <button class="update-btn" id="update-btn">GUARDAR CAMBIOS</button>
                                ${canDelete ? `<button type="button" class="delete-btn" id="delete-btn">ELIMINAR</button>` : ''}
                            </div>
                        ` : `
                            <!-- Solo para Admin -->
                            <div class="update-row two-cols">
                                <div>
                                    <label for="upd-status">ESTADO</label>
                                    <select id="upd-status">${statusOptions}</select>
                                </div>
                                <div>
                                    <label for="upd-cost">COSTO</label>
                                    <input type="number" id="upd-cost" min="0" step="0.0001" placeholder="0.00">
                                </div>
                            </div>
                            <div class="update-row">
                                <label for="upd-notes">NOTAS <span id="char-counter">${notesText.length} / 150</span></label>
                                <input type="text" id="upd-notes" maxlength="150" value="${notesText}">
                            </div>
                            <label class="checkbox-label">
                                <input type="checkbox" id="upd-completed">
                                MARCAR FECHA DE COMPLETADO COMO AHORA
                            </label>
                            <div class="button-row">
                                <button class="update-btn" id="update-btn">GUARDAR CAMBIOS</button>
                                ${canDelete ? `<button type="button" class="delete-btn" id="delete-btn">ELIMINAR</button>` : ''}
                            </div>
                        `}
                    </div>
                    ` : ''}
                `;

                if (canEdit) {
                    // Para Admin
                    if (isAdmin) {
                        const notesInput = document.getElementById('upd-notes');
                        const counter = document.getElementById('char-counter');
                        if (notesInput && counter) {
                            notesInput.addEventListener('input', () => {
                                counter.textContent = `${notesInput.value.length} / 150`;
                            });
                        }

                        document.getElementById('update-btn').addEventListener('click', async () => {
                            const status_id = document.getElementById('upd-status').value;
                            const notes = document.getElementById('upd-notes')?.value?.trim() || '';
                            const costVal = document.getElementById('upd-cost').value;
                            const set_completed_at = document.getElementById('upd-completed')?.checked;

                            if (costVal !== '' && parseFloat(costVal) < 0) {
                                Swal.fire({
                                    title: 'Costo inválido',
                                    text: 'El costo no puede ser negativo.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                return;
                            }

                            const body = { status_id };
                            if (notes) body.notes = notes;
                            if (costVal !== '') body.cost = costVal;
                            if (set_completed_at) body.set_completed_at = true;

                            try {
                                const r = await fetch(`/api/incidents/${encodeURIComponent(id)}`, {
                                    method: 'PATCH',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(body)
                                });
                                const result = await r.json();
                                if (result.success) {
                                    await Swal.fire({
                                        title: 'Actualizado',
                                        text: 'Reporte actualizado correctamente.',
                                        icon: 'success',
                                        timer: 1800,
                                        timerProgressBar: true,
                                        showConfirmButton: false,
                                        confirmButtonColor: '#6A8042'
                                    });
                                    window.location.reload();
                                } else {
                                    Swal.fire({
                                        title: 'Error',
                                        text: result.message ?? 'No se pudo actualizar.',
                                        icon: 'error',
                                        confirmButtonColor: '#d33',
                                        confirmButtonText: 'Aceptar'
                                    });
                                }
                            } catch {
                                Swal.fire({
                                    title: 'Error',
                                    text: 'Fallo de red.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                            }
                        });
                    } else {
                        // Para Owner (no-admin)
                        document.getElementById('update-btn').addEventListener('click', async () => {
                            const description = document.getElementById('upd-description')?.value?.trim() || '';
                            const area_id = document.getElementById('upd-area').value;
                            const type_id = document.getElementById('upd-type').value;

                            if (!description) {
                                Swal.fire({
                                    title: 'Campo requerido',
                                    text: 'La descripción es obligatoria.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                                return;
                            }

                            const body = {
                                description,
                                area_id,
                                type_id
                            };

                            try {
                                const r = await fetch(`/api/incidents/${encodeURIComponent(id)}`, {
                                    method: 'PATCH',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(body)
                                });
                                const result = await r.json();
                                if (result.success) {
                                    await Swal.fire({
                                        title: 'Actualizado',
                                        text: 'Reporte actualizado correctamente.',
                                        icon: 'success',
                                        timer: 1800,
                                        timerProgressBar: true,
                                        showConfirmButton: false,
                                        confirmButtonColor: '#6A8042'
                                    });
                                    window.location.reload();
                                } else {
                                    Swal.fire({
                                        title: 'Error',
                                        text: result.message ?? 'No se pudo actualizar.',
                                        icon: 'error',
                                        confirmButtonColor: '#d33',
                                        confirmButtonText: 'Aceptar'
                                    });
                                }
                            } catch {
                                Swal.fire({
                                    title: 'Error',
                                    text: 'Fallo de red.',
                                    icon: 'error',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Aceptar'
                                });
                            }
                        });
                    }

                    const deleteBtn = document.getElementById('delete-btn');
                    if (deleteBtn) {
                        deleteBtn.addEventListener('click', async () => {
                            const confirm = await Swal.fire({
                                title: '¿Eliminar incidencia?',
                                text: 'Esta acción no se puede deshacer',
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#dc3545',
                                confirmButtonText: 'Sí, eliminar',
                                cancelButtonText: 'Cancelar'
                            });

                            if (confirm.isConfirmed) {
                                try {
                                    const r = await fetch(`/api/incidents/${encodeURIComponent(id)}`, {
                                        method: 'DELETE',
                                        headers: { 'Content-Type': 'application/json' }
                                    });
                                    const result = await r.json();
                                    if (result.success) {
                                        await Swal.fire({
                                            title: 'Eliminada',
                                            text: 'Incidencia eliminada correctamente.',
                                            icon: 'success',
                                            timer: 1800,
                                            timerProgressBar: true,
                                            showConfirmButton: false,
                                            confirmButtonColor: '#6A8042'
                                        });
                                        window.location.href = '/incident-board';
                                    } else {
                                        Swal.fire({
                                            title: 'Error',
                                            text: result.message ?? 'No se pudo eliminar.',
                                            icon: 'error',
                                            confirmButtonColor: '#d33',
                                            confirmButtonText: 'Aceptar'
                                        });
                                    }
                                } catch {
                                    Swal.fire({
                                        title: 'Error',
                                        text: 'Fallo de red.',
                                        icon: 'error',
                                        confirmButtonColor: '#d33',
                                        confirmButtonText: 'Aceptar'
                                    });
                                }
                            }
                        });
                    }
                }

            } catch (e) {
                card.innerHTML = '<p class="error">Error al cargar la incidencia.</p>';
            }

            function escapeHtml(str) {
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }
        })();
    </script>
</body>
</html>









