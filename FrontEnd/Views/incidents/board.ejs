<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <link rel="stylesheet" href="/FrontEnd/CSS/board.css">
    <link rel="icon" type="image/png" href="./FrontEnd/IMG/favicon.png">
    <title>ADI - Tablón</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/FrontEnd/JS/session_manager.js"></script>
    <script src="/FrontEnd/JS/board.js" defer></script>
    <style>
        .role-badge {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.875rem;
            background: rgba(106, 128, 66, 0.12);
            border: 0.0625rem solid rgba(106, 128, 66, 0.32);
            border-radius: 1.25rem;
            font-family: "Inter", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #5D723B;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }
        .role-badge > span:first-child {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #6A8042;
        }
        .role-badge #user-role {
            white-space: normal;
        }
    </style>
</head>

<body data-min-role="1">
    <nav class="top-nav">
        <div class="nav-brand">
            <img src="/FrontEnd/IMG/logo_rectangle_h.png" alt="ADI_logo">
        </div>
        <div class="nav-title">TABLÓN DE INCIDENCIAS</div>
        <div class="nav-actions">
            <div class="role-badge">
                <span></span>
                <span id="user-role">Rol</span>
            </div>
            <a href="/profile" class="nav-icon-btn" aria-label="Perfil">
                <span class="material-symbols-outlined">person</span>
            </a>
            <a id="logout-btn" class="nav-icon-btn" href="/" aria-label="Cerrar sesión">
                <span class="material-symbols-outlined">logout</span>
            </a>
        </div>
    </nav>
    <div class="main-container">
        <div class="selects">
            <div class="filter-group">
                <label for="type">Tipo</label>
                <select name="type" id="type">
                    <option value="any">Cualquiera</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="area">Área</label>
                <select name="area" id="area">
                    <option value="any">Cualquiera</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="status">Estado</label>
                <select name="status" id="status">
                    <option value="any">Cualquiera</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="order-by">Ordenar por</label>
                <select name="order-by" id="order-by">
                    <option value="timedown">Fecha descendente</option>
                    <option value="timeup">Fecha ascendente</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="creator-filter">Creador</label>
                <select name="creator-filter" id="creator-filter">
                    <option value="any">Todos</option>
                    <option value="mine">Mis incidencias</option>
                </select>
            </div>
            <a href="/incident-create" class="btn-create-incident" aria-label="Crear incidencia">
                <span class="material-symbols-outlined">add_circle</span>
                <span>CREAR</span>
            </a>
        </div>
        <div class="table-container">
            <table>
                    <colgroup>
                        <col style="width: 75%">
                        <col style="width: 15%">
                        <col style="width: 10%">
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Información</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody id="incidents-tbody">
                        <tr><td colspan="3" style="text-align:center">Cargando...</td></tr>
                    </tbody>
                </table>
        </div>
        <div class="pagination-controls" id="incidents-pagination" style="display:none">
            <button type="button" class="page-btn" id="inc-prev-btn">ANTERIOR</button>
            <span class="page-indicator" id="inc-page-indicator">Pagina 1 de 1</span>
            <button type="button" class="page-btn" id="inc-next-btn">SIGUIENTE</button>
        </div>
        <div class="bottom-actions">
            <a href="/main" class="btn-back">REGRESAR</a>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const user = window.ADIAuth?.getCurrentUser?.();
            if (user) {
                const roleSpan = document.getElementById('user-role');
                if (roleSpan) roleSpan.textContent = window.ADIAuth.getRoleLabel(user.rol_id);
            }
        });
    </script>
    <footer>
        <p>X-CORP</p>
    </footer>
</body>

</html>








